<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <uses-permission android:name="android.permission.INTERNET" />
    <!-- 找附近的球馆和球友，只在用 App 时取。用户可以只给大概位置 -->
    <uses-permission android:name="android.permission.ACCESS_COARSE_LOCATION" />
    <uses-permission android:name="android.permission.ACCESS_FINE_LOCATION" />
    <!-- 球局提醒（Android 13 起要问） -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <!-- 等级卡片存到相册：Android 10 起不用权限，以前的系统要 -->
    <uses-permission
        android:name="android.permission.WRITE_EXTERNAL_STORAGE"
        android:maxSdkVersion="28" />

    <application
        android:name=".BadieApplication"
        android:allowBackup="false"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:icon="@mipmap/ic_launcher"
        android:label="Badie"
        android:localeConfig="@xml/locales_config"
        android:networkSecurityConfig="@xml/network_security_config"
        android:supportsRtl="true"
        android:theme="@style/Theme.Badie">
        <!-- singleTask：点链接、Apple 登录跳回来都回到同一个界面（onNewIntent），不在别的 App 里再开一个 -->
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:launchMode="singleTask"
            android:screenOrientation="portrait">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
            <!-- 点开 badie.rsvp 的链接直接进 App（App Links）。路径和 iPhone 的 web/public/.well-known/apple-app-site-association 一致；
                 网站上有了 assetlinks.json 才会自动进 App，见 docs/RELEASE.md -->
            <intent-filter android:autoVerify="true">
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="https" />
                <data android:host="badie.rsvp" />
                <data android:pathPrefix="/games/" />
                <data android:pathPrefix="/rooms/" />
                <data android:pathPrefix="/groups/" />
                <data android:pathPrefix="/join/" />
                <data android:pathPrefix="/add/" />
                <data android:pathPrefix="/challenges/" />
                <data android:pathPrefix="/messages/" />
                <data android:pathPrefix="/levels/" />
                <!-- 别的语言的等级页：/zh/levels/… -->
                <data android:pathPattern="/.*/levels/.*" />
            </intent-filter>
            <!-- Apple 登录在浏览器里授权完跳回来（remote/SocialSignIn.kt 的 CALLBACK） -->
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="com.badie.app" android:host="auth" android:path="/callback" />
            </intent-filter>
        </activity>

        <!-- 球局开始前的提醒 -->
        <receiver
            android:name=".features.games.GameReminderReceiver"
            android:exported="false" />

        <!-- 推送（Firebase Cloud Messaging）：收新令牌和服务器的推送，见 push/PushNotifications.kt -->
        <service
            android:name=".push.BadieMessagingService"
            android:exported="false">
            <intent-filter>
                <action android:name="com.google.firebase.MESSAGING_EVENT" />
            </intent-filter>
        </service>
        <!-- 不自动要令牌：允许了通知才要（和 iPhone 一样），见 push/PushRegistry.kt -->
        <meta-data
            android:name="firebase_messaging_auto_init_enabled"
            android:value="false" />

        <!-- 分享等级卡片：把缓存里的图片给别的 App 读 -->
        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.files"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/file_paths" />
        </provider>

        <!-- Android 13 以前：App 里选的语言由这个服务记住，下次启动接着用 -->
        <service
            android:name="androidx.appcompat.app.AppLocalesMetadataHolderService"
            android:enabled="false"
            android:exported="false">
            <meta-data
                android:name="autoStoreLocales"
                android:value="true" />
        </service>
    </application>
</manifest>
