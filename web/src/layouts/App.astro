---
// App 的入口页面：首页、等级对照表、关于……都挂同一个 App。
// 页面里的静态内容给搜索引擎和不开脚本的人看（开了脚本就藏起来）；有脚本时先显示转圈，App 加载后接管
import '../styles/global.css';
import App from '../app/App';
import { alternates, pageLocale } from '../lib/static-i18n';

interface Props {
  title: string;
  description: string;
  noindex?: boolean;
  jsonLd?: object;
}

const { title, description, noindex = false, jsonLd } = Astro.props;
const canonical = new URL(Astro.url.pathname, Astro.site);
// 中文版页面（/zh/…）固定用中文；有中文版的页面互相标出另一种语言的地址
const locale = pageLocale(Astro.url.pathname);
const languages = alternates(Astro.url.pathname, Astro.site ?? new URL('http://localhost'));
---

<!doctype html>
<html lang={locale} data-fixed-locale={locale === 'en' ? undefined : locale}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    {languages.map((link) => <link rel="alternate" hreflang={link.hreflang} href={link.href} />)}
    {noindex && <meta name="robots" content="noindex" />}
    <meta name="color-scheme" content="light dark" />
    <meta name="theme-color" content="#17140f" />
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="Badie" />
    <meta property="og:locale" content={locale === 'en' ? 'en_US' : 'zh_CN'} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={new URL('/og.png', Astro.site)} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta name="twitter:card" content="summary_large_image" />
    <link rel="icon" href="/favicon.png" type="image/png" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <link rel="manifest" href="/manifest.webmanifest" />
    {jsonLd && <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />}
    <script is:inline>document.documentElement.classList.add('js');</script>
  </head>
  <body class="min-h-dvh antialiased">
    <App client:only="react">
      <div slot="fallback">
        <div class="js-only min-h-dvh">
          <div class="h-16 bg-bar"></div>
          <p role="status" class="grid min-h-[60dvh] place-items-center">
            <span aria-hidden="true" class="size-6 animate-spin rounded-full border-[3px] border-ink-secondary border-t-transparent"></span>
            <span class="sr-only">Loading…</span>
          </p>
        </div>
      </div>
    </App>
    <!-- 不跑脚本时显示的静态内容放在 App 外面：放进 fallback 插槽的话，Astro 会在 <template> 里再存一份，源码里就有两个 h1 -->
    <div id="static-page" class="static-only page grid gap-6 py-10">
      <a href="/" class="text-[1.75rem] font-black">badie.</a>
      <slot />
      <!-- 不跑脚本的抓取器（比如 Google 的品牌审核）也要能在首页看到隐私政策的链接 -->
      <nav aria-label="Badie" class="flex flex-wrap gap-x-4 gap-y-1 text-footnote">
        <a class="link" href="/privacy/">Privacy Policy</a>
        <a class="link" href="/terms/">Terms of Service</a>
        <a class="link" href="/contact/">Contact us</a>
      </nav>
    </div>
  </body>
</html>
