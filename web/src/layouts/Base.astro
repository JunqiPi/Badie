---
import '../styles/global.css';
import { countries } from '../lib/venues';

interface Props {
  title: string;
  description: string;
  noindex?: boolean;
  jsonLd?: object;
}

const { title, description, noindex = false, jsonLd } = Astro.props;
const canonical = new URL(Astro.url.pathname, Astro.site);
const nav = [
  { label: 'Courts', href: '/courts/' },
  { label: 'How it works', href: '/#how' },
  { label: 'About', href: '/#about' },
];
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    {noindex && <meta name="robots" content="noindex, follow" />}
    <meta name="color-scheme" content="light dark" />
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="Badie" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="sitemap" href="/sitemap-index.xml" />
    {jsonLd && <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />}
  </head>
  <body class="min-h-screen antialiased lg:p-4">
    <div class="min-h-screen bg-canvas lg:min-h-[calc(100vh-2rem)] lg:rounded-[32px] lg:border-2 lg:border-stroke">
      <header class="relative mx-auto flex max-w-6xl items-center justify-between px-5 py-5 lg:px-8">
        <a href="/" class="flex items-center gap-2 text-2xl font-black tracking-tight">
          <span class="sticker grid size-9 place-items-center rounded-xl! bg-lime text-on-accent">B</span>
          Badie
        </a>
        <nav aria-label="Main" class="absolute top-0 left-1/2 hidden -translate-x-1/2 rounded-b-[22px] bg-ink px-8 py-3 lg:block">
          <ul class="flex gap-8 text-sm font-extrabold text-canvas">
            {nav.map((item) => <li><a href={item.href} class="hover:text-lime">{item.label}</a></li>)}
          </ul>
        </nav>
        <a href="/courts/" class="font-extrabold text-ink-secondary hover:text-ink lg:hidden">Courts</a>
        <a href="/#app" class="hidden rounded-full border-2 border-stroke px-5 py-2 text-sm font-extrabold hover:bg-surface lg:inline-flex">
          Get the app
        </a>
      </header>

      <main class="mx-auto max-w-6xl px-5 pb-20 lg:px-8">
        <slot />
      </main>

      <footer class="border-t-2 border-stroke/15">
        <div class="mx-auto grid max-w-6xl gap-8 px-5 py-10 text-sm text-ink-secondary sm:grid-cols-[2fr_1fr] lg:px-8">
          <div class="space-y-2">
            <p class="font-extrabold text-ink">Badie</p>
            <p class="max-w-prose">A free, nonprofit app for finding badminton partners at your level and courts near you. No ads.</p>
            <slot name="attribution" />
          </div>
          <div>
            <p class="eyebrow mb-3">Courts</p>
            <ul class="space-y-1">
              {countries.map((country) => <li><a href={country.path} class="hover:text-ink">{country.name}</a></li>)}
            </ul>
          </div>
        </div>
      </footer>
    </div>
  </body>
</html>
