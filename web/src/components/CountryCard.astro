---
import { cityName, type Country } from '../lib/venues';

interface Props {
  country: Country;
  tint: string;
}

const { country, tint } = Astro.props;
// 国旗：两个“区域指示符”字母拼成的 emoji（不支持的系统上显示成两个字母，也看得懂）
const flag = String.fromCodePoint(...[...country.code.toUpperCase()].map((letter) => 0x1f1a5 + letter.charCodeAt(0)));
---

<article class:list={['sticker lift relative grid gap-3 p-4 text-on-accent', tint]}>
  <div class="flex items-center gap-3">
    <span aria-hidden="true" class="grid size-12 shrink-0 place-items-center rounded-[14px] border-2 border-stroke bg-white text-[1.75rem] leading-none">{flag}</span>
    <div class="min-w-0 flex-1">
      <h3 class="truncate text-headline"><a href={country.path} class="after:absolute after:inset-0 after:content-['']" data-region={country.code}>{country.name}</a></h3>
      {
        country.cities.length > 1 ? (
          <p class="text-footnote font-bold" data-t="{n} courts in {areas} areas" data-n={country.venueCount} data-areas={country.cities.length}>
            {country.venueCount.toLocaleString('en')} courts in {country.cities.length.toLocaleString('en')} areas
          </p>
        ) : (
          <p class="text-footnote font-bold" data-t="{n} court|{n} courts" data-n={country.venueCount}>
            {country.venueCount.toLocaleString('en')} courts
          </p>
        )
      }
    </div>
  </div>
  <ul class="relative z-10 flex flex-wrap gap-1.5 text-footnote font-bold">
    {
      country.cities.slice(0, 3).map((city) => (
        <li>
          <a href={city.path} class="inline-flex min-h-8 items-center rounded-full border-[1.5px] border-stroke bg-white px-3 transition-colors hover:bg-lime">
            {cityName(city)}
          </a>
        </li>
      ))
    }
  </ul>
</article>
