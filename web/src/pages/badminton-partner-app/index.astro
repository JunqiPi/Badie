---
// 找搭子的介绍页（只有英文）：对准 “badminton partner app”。口径按 Badie-iOS/docs/STORY.md，只写已经做到的事
import Base from '../../layouts/Base.astro';
import { APP_STORE_URL } from '../../app/Contact';
import { faq as aboutFaq } from '../../app/faq';

const site = Astro.site ?? new URL('http://localhost');
const faq = [
  ...aboutFaq.filter((f) => ['Is Badie free?', 'How does Badie know my level?', 'Can I find doubles or mixed doubles partners?', 'Who can see my information?'].includes(f.q)),
  {
    q: 'What if someone doesn’t show up?',
    a: 'It counts as a no-show when most people in the game say the player didn’t come and they didn’t check in. Within 180 days, the first time is a warning, the second blocks new games for 7 days, and the third blocks them for good. Players can appeal within 48 hours.',
  },
];

const jsonLd = {
  '@context': 'https://schema.org',
  '@graph': [
    {
      '@type': 'SoftwareApplication',
      name: 'Badie',
      url: new URL('/badminton-partner-app/', site).href,
      applicationCategory: 'SportsApplication',
      operatingSystem: 'iOS, Web',
      offers: { '@type': 'Offer', price: '0', priceCurrency: 'USD' },
      description: 'A free app that finds badminton partners at your level, for singles, doubles and mixed doubles.',
    },
    {
      '@type': 'FAQPage',
      mainEntity: faq.map((f) => ({ '@type': 'Question', name: f.q, acceptedAnswer: { '@type': 'Answer', text: f.a } })),
    },
  ],
};

const steps = [
  ['Set your level', 'A 2-minute quiz places you on a 1–9 scale. You can take it before you sign up.'],
  ['Get matched', 'Pick when you’re free and which courts you can get to. Quick Match finds someone at a similar level. The game is on when you both confirm.'],
  ['Play, then confirm', 'After the game, both sides confirm the result. The players you meet help keep levels accurate.'],
];
---

<Base
  title="Badminton partner app — find players at your level | Badie"
  description="No need to ask strangers for a game. Badie finds badminton players at your level for singles, doubles and mixed doubles. Free, no ads."
  jsonLd={jsonLd}
>
  <div class="mx-auto grid max-w-3xl gap-10">
    <header class="grid justify-items-start gap-4">
      <h1 class="text-display lg:text-[2.75rem]">Find badminton partners at your level</h1>
      <p class="max-w-prose text-[1.0625rem] leading-relaxed text-ink-secondary">
        No need to ask strangers for a game. Badie finds badminton players at your level for you. Free.
      </p>
      <div class="flex flex-wrap gap-2">
        <a href="/play/" class="button button-lg">Start matching</a>
        <a href={APP_STORE_URL} class="button button-lg button-quiet">Get the iPhone app</a>
      </div>
      <a href="/level-quiz/" class="link text-footnote font-bold">Find your level · 2 min, no sign-up</a>
    </header>

    <section aria-labelledby="how" class="grid gap-3">
      <h2 id="how" class="text-title2">How Badie works</h2>
      <ol class="grid gap-3">
        {steps.map(([title, text], i) => (
          <li class="sticker flex items-start gap-3 p-4">
            <span class="grid size-7 shrink-0 place-items-center rounded-full bg-[#17140f] text-footnote font-black text-lime">{i + 1}</span>
            <div>
              <h3 class="text-headline">{title}</h3>
              <p class="mt-1 text-subhead">{text}</p>
            </div>
          </li>
        ))}
      </ol>
    </section>

    <section aria-labelledby="when" class="grid gap-3">
      <h2 id="when" class="text-title2">When it helps</h2>
      <dl class="grid gap-3 sm:grid-cols-2">
        <div class="sticker p-4">
          <dt class="text-headline">You don’t want to ask around</dt>
          <dd class="mt-1 text-subhead">Walking up to strangers at the gym takes nerve, and you don’t know their level until you’re on court. Badie does the asking.</dd>
        </div>
        <div class="sticker p-4">
          <dt class="text-headline">Your usual partner can’t make it</dt>
          <dd class="mt-1 text-subhead">Quick Match looks for someone at your level who is free at the same time.</dd>
        </div>
        <div class="sticker p-4">
          <dt class="text-headline">You want to see who’s free on a day</dt>
          <dd class="mt-1 text-subhead">Pick a day and go through players nearby who are free then and close to your level. Swipe right to invite them.</dd>
        </div>
        <div class="sticker p-4">
          <dt class="text-headline">You just moved</dt>
          <dd class="mt-1 text-subhead">
            Find <a class="link" href="/courts/">courts near you</a>, weekly groups and open games in your first week.
          </dd>
        </div>
      </dl>
    </section>

    <section aria-labelledby="doubles" class="grid gap-2">
      <h2 id="doubles" class="text-title2">Singles, doubles and mixed</h2>
      <p class="max-w-prose text-subhead">
        Choose men’s or women’s singles, men’s, women’s or mixed doubles. Men’s and women’s levels are counted separately.
        Booked a court but short on players? Post it and nearby players can join.
      </p>
    </section>

    <section aria-labelledby="groups" class="grid gap-2">
      <h2 id="groups" class="text-title2">Run a group or a tournament</h2>
      <p class="max-w-prose text-subhead">
        Organizers use Badie for <a class="link" href="/badminton-group-app/">weekly sessions, sign-ups and court fees</a>.
        For one evening, the <a class="link" href="/badminton-tournament-maker/">tournament maker</a> makes a round robin schedule without signing up.
      </p>
    </section>

    <section aria-labelledby="faq" class="grid gap-3">
      <h2 id="faq" class="text-title2">Questions</h2>
      {faq.map((f) => (
        <details class="sticker p-4">
          <summary class="cursor-pointer text-headline">{f.q}</summary>
          <p class="mt-2 text-subhead">{f.a}</p>
        </details>
      ))}
    </section>
  </div>
</Base>
