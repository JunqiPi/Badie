---
// 其他 9 种语言的等级对照表（/zh/levels/、/ja/levels/……）：每级几条表现（和网页 App 里的等级表同一份译文），分项标准在每一档自己的页面里，
// 1–6 级每一档和 7–9 级都链到自己的页面
import Base from '../../../layouts/Base.astro';
import { levels } from '../../../app/levels';
import { prefixes, translator } from '../../../lib/static-i18n';
import { tierSlugs } from '../../../lib/tiers';

export const getStaticPaths = () => prefixes.map((lang) => ({ params: { lang } }));

const t = translator(Astro.url.pathname);
---

<Base title={t('Badminton level chart 1–9 — Badie')} description={t('What each badminton level from 1 to 9 looks like on court: rallies, footwork, attack and defense, up to state, national and international level.')}>
  <div class="mx-auto grid max-w-3xl gap-6">
    <header>
      <h1 class="text-display lg:text-[2.75rem]">{t('Level chart')}</h1>
      <p class="text-subhead font-bold text-ink-secondary">{t('Badie levels 1–9')}</p>
    </header>
    <a href="/level-quiz/" class="sticker lift grid gap-0.5 bg-lime p-4 text-on-accent">
      <span class="text-headline">{t('What level are you?')}</span>
      <span class="text-footnote font-bold">{t('Find your level · 2 min, no sign-up')}</span>
    </a>
    <p class="max-w-prose text-subhead">{t('Nine levels, each split into −, base and +. Go by what you can do most of the time, not your best shot.')}</p>
    <ol class="grid gap-4">
      {levels.map((l) => (
        <li class="sticker grid gap-3 p-5">
          <h2 class="text-title3">Lv.{l.level} {t(l.name)}</h2>
          <p class="flex flex-wrap gap-2 text-footnote font-bold">
            {tierSlugs(l.level).map(({ slug, label }) => <a class="link" href={`/levels/${slug}/`}>{label}</a>)}
          </p>
          <p class="text-caption text-ink-secondary">{[l.usFlight && `≈ ${t(l.usFlight)}`, t(l.experience)].filter(Boolean).join(' · ')}</p>
          <ul class="list-disc pl-5 text-subhead">{l.anchors.map((a) => <li>{t(a)}</li>)}</ul>
        </li>
      ))}
    </ol>
    <p class="text-caption text-ink-tertiary">{t('Men and women are rated separately. In mixed games, a women’s level counts about 1.5 lower.')}</p>
  </div>
</Base>
