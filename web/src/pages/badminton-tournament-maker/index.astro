---
// 排表工具（只有英文）：搜 “badminton tournament maker” 的人要的是马上能用的工具，所以不登录就能排出全部对阵、打印、复制链接。
// 排法和登录后的“比赛”一样；要输比分、看实时看板，点“在 Badie 里开始”
import Base from '../../layouts/Base.astro';
import { TournamentMaker } from '../../app/TournamentMaker';

const site = Astro.site ?? new URL('http://localhost');
const faq = [
  {
    q: 'Is it free?',
    a: 'Yes. Making a schedule needs no account. Running the tournament live in Badie is free too, with no ads.',
  },
  {
    q: 'How many players can I add?',
    a: 'Up to 64. Singles needs at least 2 players, doubles at least 4. Fixed partners need an even number. Swiss needs at least 3 players or pairs.',
  },
  {
    q: 'How are rotating partners picked?',
    a: 'Each round you play with someone you haven’t partnered yet, against people you’ve faced the least. If the number of players isn’t a multiple of 4, a few people rest each round, and rests are spread evenly.',
  },
  {
    q: 'How are players ranked?',
    a: 'By wins. If people played a different number of games, by win rate. Then point difference, points scored, and the game between the two. If it’s still even, it’s a tie.',
  },
  {
    q: 'Why does the bracket only show the first round?',
    a: 'Later knockout rounds and Swiss rounds depend on who wins. Run the tournament in Badie and they fill in as scores come in.',
  },
  {
    q: 'Can players see the schedule on their phones?',
    a: 'Copy the link and send it to your group. To show who’s on which court and the live standings, start the tournament in Badie and share its link or QR code. Nobody needs an account to watch.',
  },
];

const jsonLd = {
  '@context': 'https://schema.org',
  '@graph': [
    {
      '@type': 'WebApplication',
      name: 'Badie tournament maker',
      url: new URL('/badminton-tournament-maker/', site).href,
      applicationCategory: 'SportsApplication',
      operatingSystem: 'Any',
      browserRequirements: 'Requires JavaScript',
      offers: { '@type': 'Offer', price: '0', priceCurrency: 'USD' },
      description: 'Make a badminton round robin, knockout bracket, groups and knockout, or Swiss draw for singles or doubles, with rotating or fixed partners.',
    },
    {
      '@type': 'FAQPage',
      mainEntity: faq.map((f) => ({ '@type': 'Question', name: f.q, acceptedAnswer: { '@type': 'Answer', text: f.a } })),
    },
  ],
};
---

<Base
  title="Badminton tournament maker — free brackets and round robins | Badie"
  description="Type the names and get the draw: round robin, rotating doubles partners, groups and knockout, Swiss or a knockout bracket. Free, no sign-up."
  jsonLd={jsonLd}
>
  <div class="mx-auto grid max-w-3xl gap-10">
    <header class="grid gap-3 print:hidden">
      <h1 class="text-display lg:text-[2.75rem]">Badminton tournament maker</h1>
      <p class="max-w-prose text-[1.0625rem] leading-relaxed text-ink-secondary">
        Type the names, pick a format and get the draw. Print it or send the link. Free, and no sign-up.
      </p>
    </header>

    <TournamentMaker client:load />

    <section aria-labelledby="formats" class="grid gap-3 print:hidden">
      <h2 id="formats" class="text-title2">Formats</h2>
      <p class="max-w-prose text-subhead">Pick singles, doubles with fixed partners, or doubles with rotating partners. Then pick how the games are drawn.</p>
      <dl class="grid gap-3 sm:grid-cols-2">
        <div class="sticker p-4">
          <dt class="text-headline">Round robin</dt>
          <dd class="mt-1 text-subhead">Everyone plays everyone once, or twice if you add rounds. With an odd number, one player or pair rests each round.</dd>
        </div>
        <div class="sticker p-4">
          <dt class="text-headline">Doubles, rotating partners</dt>
          <dd class="mt-1 text-subhead">A new partner every round, up to 30 rounds. Good for club nights where people come on their own. Ranked by each player’s wins.</dd>
        </div>
        <div class="sticker p-4">
          <dt class="text-headline">Groups + knockout</dt>
          <dd class="mt-1 text-subhead">2 to 8 groups play a round robin. The top 1 or 2 of each group go into a knockout bracket.</dd>
        </div>
        <div class="sticker p-4">
          <dt class="text-headline">Knockout</dt>
          <dd class="mt-1 text-subhead">Any number of players. The top seeds get a bye when the bracket isn’t full, and the 1st and 2nd seeds can only meet in the final.</dd>
        </div>
        <div class="sticker p-4">
          <dt class="text-headline">Swiss</dt>
          <dd class="mt-1 text-subhead">Round 1 is top half against bottom half. After that, players with similar records meet, and nobody plays the same opponent twice if it can be avoided.</dd>
        </div>
        <div class="sticker p-4">
          <dt class="text-headline">Third place</dt>
          <dd class="mt-1 text-subhead">Knockout and groups can add a third-place match between the semifinal losers.</dd>
        </div>
      </dl>
    </section>

    <section aria-labelledby="live" class="grid gap-3 print:hidden">
      <h2 id="live" class="text-title2">Run it live in Badie</h2>
      <p class="max-w-prose text-subhead">
        Start the same schedule in Badie when you want scores and standings on the night. Your names and settings come with you.
      </p>
      <ul class="grid gap-2 text-subhead">
        <li class="sticker p-4">Games go to whichever court is free. If someone is still playing, the next game that can start goes on.</li>
        <li class="sticker p-4">You, up to 3 helpers, or players with a Badie account enter scores. The standings update as you go.</li>
        <li class="sticker p-4">Players open a link or scan a QR code to see who’s on court, what’s next and the standings. No account needed to watch.</li>
        <li class="sticker p-4">If someone gets hurt or has to leave, record it and the other side wins. With rotating partners you can also add a player who turns up late.</li>
        <li class="sticker p-4">When it’s over, share the final standings as an image.</li>
      </ul>
      <p class="text-footnote text-ink-secondary">
        Running the same group every week? <a class="link" href="/badminton-group-app/">Badie also handles sign-ups, the court rotation and court fees</a>.
      </p>
    </section>

    <section aria-labelledby="faq" class="grid gap-3 print:hidden">
      <h2 id="faq" class="text-title2">Questions</h2>
      {faq.map((f) => (
        <details class="sticker group p-4">
          <summary class="cursor-pointer text-headline">{f.q}</summary>
          <p class="mt-2 text-subhead">{f.a}</p>
        </details>
      ))}
    </section>
  </div>
</Base>

<style is:global>
  /* 打印时只留对阵表 */
  @media print {
    header, footer, nav, [data-shell-chrome] { display: none !important; }
    body { background: white; }
  }
</style>
