---
import Base from '../../layouts/Base.astro';
import CountryCard from '../../components/CountryCard.astro';
import CourtSearch from '../../components/CourtSearch.astro';
import { Courts } from '../../app/Courts';
import { allVenues, byContinent, countries } from '../../lib/venues';

const tints = ['bg-sky', 'bg-peach', 'bg-mint', 'bg-lavender', 'bg-butter', 'bg-pink'];
---

<Base
  title="Badminton courts by country — Badie"
  description={`${allVenues.length.toLocaleString('en')} badminton courts in ${countries.length} countries, from government open data, OpenStreetMap and players.`}
>
  <header class="grid gap-4 lg:grid-cols-[1fr_28rem] lg:items-end">
    <div>
      <p class="text-subhead font-bold text-ink-secondary" data-t="{n} courts in {countries} countries" data-n={allVenues.length} data-countries={countries.length}>
        {allVenues.length.toLocaleString('en')} courts in {countries.length} countries
      </p>
      <h1 class="text-display lg:text-[2.75rem]" data-t="Courts">Courts</h1>
    </div>
    <CourtSearch />
  </header>

  <div class="mt-8"><Courts client:only="react" /></div>

  <section class="mt-12 grid gap-6" aria-labelledby="countries">
    <h2 id="countries" class="text-title2" data-t="Browse by country">Browse by country</h2>
    <div class="grid gap-4 sm:grid-cols-2 lg:grid-cols-4">
      {
        byContinent().flatMap((group) => group.countries).map((country) => (
          <CountryCard country={country} tint={tints[countries.indexOf(country) % tints.length]} />
        ))
      }
    </div>
  </section>
</Base>
