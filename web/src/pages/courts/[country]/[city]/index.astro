---
import Base from '../../../../layouts/Base.astro';
import Breadcrumbs from '../../../../components/Breadcrumbs.astro';
import DotMap from '../../../../components/DotMap.astro';
import VenueRow from '../../../../components/VenueRow.astro';
import { cityName, citySummary, countries, formatPrice, nearbyCities, type City, type Country } from '../../../../lib/venues';

export function getStaticPaths() {
  return countries.flatMap((country) =>
    country.cities.map((city) => ({ params: { country: country.code, city: city.slug }, props: { country, city } })),
  );
}

const { country, city } = Astro.props as { country: Country; city: City };
const name = cityName(city);
const count = city.venues.length;
const summary = citySummary(city);
const neighbours = nearbyCities(city);
const attributions = [...new Set(city.venues.map((v) => v.attribution).filter(Boolean))];
const points = city.venues.map((v) => ({ id: v.id, lat: v.lat, lon: v.lon, label: v.name, href: v.path }));

const facts = [
  `${count} badminton ${count === 1 ? 'court is' : 'courts are'} listed in ${name}.`,
  summary.largest?.courts && `The largest is ${summary.largest.name} with ${summary.largest.courts} courts.`,
  summary.cheapest &&
    (summary.cheapest.price!.perPerson === 0
      ? `${summary.priced} list a drop-in price, and some are free.`
      : `${summary.priced} list a drop-in price, from ${formatPrice(summary.cheapest.price!.perPerson!, summary.cheapest.country)} per person.`),
].filter(Boolean);
---

<Base
  title={`Badminton courts in ${name} — Badie`}
  description={facts.join(' ')}
  noindex={!city.indexable}
>
  <Breadcrumbs items={[{ label: 'Courts', href: '/courts/' }, { label: country.name, href: country.path }]} />

  <header class="max-w-3xl">
    <p class="eyebrow">{country.name}</p>
    <h1 class="display mt-3 text-[clamp(2.5rem,6vw,4.5rem)]">Badminton courts in {name}</h1>
    <p class="mt-4 text-lg text-ink-secondary">{facts.join(' ')}</p>
  </header>

  <details class="tile mt-8 bg-surface lg:hidden">
    <summary class="cursor-pointer px-4 py-3 font-extrabold">Show map</summary>
    <div class="border-t-2 border-stroke p-3"><DotMap points={points} label={`Map of courts in ${name}`} /></div>
  </details>

  <div class="mt-8 grid gap-8 lg:grid-cols-[1fr_400px]">
    <div class="grid grid-cols-1 content-start gap-3" data-venue-list>
      {city.venues.map((venue) => <VenueRow venue={venue} />)}
    </div>

    <aside class="hidden lg:block">
      <div class="sticky top-6 space-y-4">
        <div class="tile bg-surface p-3">
          <DotMap points={points} label={`Map of courts in ${name}`} />
        </div>
        {
          summary.totalCourts > 0 && (
            <div class="grid grid-cols-2 gap-3">
              <div class="tile bg-sky p-4 text-on-accent">
                <p class="display text-4xl">{count}</p>
                <p class="text-sm font-extrabold">{count === 1 ? 'venue' : 'venues'}</p>
              </div>
              <div class="tile bg-mint p-4 text-on-accent">
                <p class="display text-4xl">{summary.totalCourts}</p>
                <p class="text-sm font-extrabold">courts in total</p>
              </div>
            </div>
          )
        }
      </div>
    </aside>
  </div>

  {
    neighbours.length > 0 && (
      <section class="mt-14">
        <h2 class="eyebrow">Nearby areas</h2>
        <ul class="mt-4 flex flex-wrap gap-2">
          {neighbours.map((other) => (
            <li>
              <a href={other.path} class="sticker lift inline-flex items-center gap-2 rounded-full! px-4 py-2 font-extrabold">
                {cityName(other)}
                <span class="text-ink-tertiary">{other.venues.length}</span>
              </a>
            </li>
          ))}
        </ul>
      </section>
    )
  }

  <Fragment slot="attribution">{attributions.length > 0 && <p>{attributions.join(' · ')}</p>}</Fragment>
</Base>

<script>
  for (const row of document.querySelectorAll<HTMLElement>('[data-venue-list] [data-venue]')) {
    const dots = document.querySelectorAll(`circle[data-venue="${row.dataset.venue}"]`);
    row.addEventListener('mouseenter', () => dots.forEach((dot) => dot.classList.add('active')));
    row.addEventListener('mouseleave', () => dots.forEach((dot) => dot.classList.remove('active')));
  }
</script>
