---
import Base from '../../../../layouts/Base.astro';
import Breadcrumbs from '../../../../components/Breadcrumbs.astro';
import DotMap from '../../../../components/DotMap.astro';
import VenueRow from '../../../../components/VenueRow.astro';
import { cityName, countries, englishName, facilityLabel, formatAddress, formatPrice, nearby, type City, type Country, type Venue } from '../../../../lib/venues';

export function getStaticPaths() {
  return countries.flatMap((country) =>
    country.cities.flatMap((city) =>
      city.venues.map((venue) => ({
        params: { country: country.code, city: city.slug, venue: venue.slug },
        props: { country, city, venue },
      })),
    ),
  );
}

const { country, city, venue } = Astro.props as { country: Country; city: City; venue: Venue };
const alias = englishName(venue);
const address = formatAddress(venue);
const place = cityName(city);
const others = nearby(venue);

const facts = [
  venue.courts && { label: 'courts', value: String(venue.courts), tint: 'bg-sky' },
  venue.price?.perPerson !== undefined && { label: 'drop-in per person', value: formatPrice(venue.price.perPerson, venue.country), tint: 'bg-butter' },
  venue.price?.perCourtHour && { label: 'court rental per hour', value: formatPrice(venue.price.perCourtHour, venue.country), tint: 'bg-peach' },
].filter((fact): fact is { label: string; value: string; tint: string } => Boolean(fact));
const mapPoints = [
  { lat: venue.lat, lon: venue.lon, label: venue.name, highlight: true },
  ...others.map(({ venue: other }) => ({ lat: other.lat, lon: other.lon, label: other.name, href: other.path })),
];
const appleMaps = `https://maps.apple.com/?q=${encodeURIComponent(venue.name)}&ll=${venue.lat},${venue.lon}`;
const googleMaps = `https://www.google.com/maps/search/?api=1&query=${venue.lat},${venue.lon}`;

const checked = venue.checked && new Date(`${venue.checked}T12:00:00Z`).toLocaleDateString('en-US', { month: 'long', year: 'numeric' });
const sourceNote = {
  curated: checked
    ? `Checked against the venue's official pages by the Badie team in ${checked}.`
    : 'Address checked against at least two public sources by the Badie team.',
  openStreetMap: 'From OpenStreetMap. Not yet confirmed by players.',
  openData: 'From government open data.',
}[venue.source];

const site = Astro.site ?? new URL('http://localhost');
const jsonLd = {
  '@context': 'https://schema.org',
  '@graph': [
    {
      '@type': 'SportsActivityLocation',
      name: venue.name,
      alternateName: venue.aliases?.length ? venue.aliases : undefined,
      address: {
        '@type': 'PostalAddress',
        streetAddress: [venue.street, venue.unit].filter(Boolean).join(', ') || undefined,
        addressLocality: venue.city,
        addressRegion: venue.region || undefined,
        postalCode: venue.postcode || undefined,
        addressCountry: venue.country,
      },
      geo: { '@type': 'GeoCoordinates', latitude: venue.lat, longitude: venue.lon },
      telephone: venue.phone,
      sameAs: venue.web,
    },
    {
      '@type': 'BreadcrumbList',
      itemListElement: [
        { name: 'Courts', path: '/courts/' },
        { name: country.name, path: country.path },
        { name: place, path: city.path },
        { name: venue.name, path: venue.path },
      ].map((item, index) => ({ '@type': 'ListItem', position: index + 1, name: item.name, item: new URL(item.path, site).href })),
    },
  ],
};
---

<Base
  title={`${venue.name}${alias ? ` (${alias})` : ''} — badminton in ${place} — Badie`}
  description={`${venue.name}: badminton ${venue.courts ? `with ${venue.courts} courts ` : ''}at ${address}.`}
  noindex={!venue.indexable}
  jsonLd={jsonLd}
>
  <Breadcrumbs
    items={[
      { label: 'Courts', href: '/courts/' },
      { label: country.name, href: country.path },
      { label: place, href: city.path },
    ]}
  />

  <div class="grid gap-8 lg:grid-cols-[1fr_360px]">
    <header class="min-w-0 lg:col-start-1">
      <div class="flex flex-wrap items-center gap-2">
        <span class="chip bg-lime">{venue.facility ? facilityLabel[venue.facility] : 'Badminton court'}</span>
        {!venue.confirmed && <span class="chip bg-surface-muted text-ink">Not yet confirmed by players</span>}
      </div>
      <h1 class="display mt-4 text-[clamp(2.5rem,5.5vw,4.25rem)] break-words">{venue.name}</h1>
      {alias && <p class="mt-2 text-xl font-black text-ink-secondary">{alias}</p>}
      <p class="mt-3 text-lg text-ink-secondary">{address}</p>
      {
        venue.playTimes && (
          <div class="tile mt-6 bg-surface p-4 sm:p-5">
            <p class="eyebrow">Badminton hours</p>
            <p class="mt-2 font-bold">{venue.playTimes}</p>
            <p class="mt-2 text-sm text-ink-secondary">Times change often. Check the official website before you go.</p>
          </div>
        )
      }
      {
        facts.length > 0 && (
          <dl class="mt-8 grid grid-cols-3 gap-2 sm:gap-3">
            {facts.map((fact) => (
              <div class:list={['tile flex flex-col-reverse p-3 text-on-accent sm:p-4', fact.tint]}>
                <dt class="mt-1 text-xs font-extrabold sm:text-sm">{fact.label}</dt>
                <dd class="display text-3xl sm:text-5xl">{fact.value}</dd>
              </div>
            ))}
          </dl>
        )
      }
    </header>

    <aside class="lg:col-start-2 lg:row-span-2 lg:row-start-1">
      <div class="space-y-4 lg:sticky lg:top-6">
        <div class="sticker overflow-hidden">
          <div class="border-b-2 border-stroke bg-sky p-3">
            <DotMap points={mapPoints} label={`${venue.name} and ${others.length} nearby courts`} onTint />
          </div>
          <div class="p-5">
            <p class="eyebrow">Get there</p>
            <div class="mt-4 grid gap-2">
              <a class="button" href={appleMaps}>Directions in Apple Maps</a>
              <a class="button button-quiet" href={googleMaps}>Google Maps</a>
            </div>
            {
              (venue.web || venue.phone) && (
                <ul class="mt-5 space-y-2 border-t-2 border-stroke/15 pt-4 font-bold">
                  {venue.web && (
                    <li>
                      <a href={venue.web} rel="nofollow noopener" class="underline decoration-2 underline-offset-4 hover:text-ink-secondary">
                        Official website
                      </a>
                    </li>
                  )}
                  {venue.phone && (
                    <li>
                      <a href={`tel:${venue.phone.replace(/[^+\d]/g, '')}`} class="hover:text-ink-secondary">
                        {venue.phone}
                      </a>
                    </li>
                  )}
                </ul>
              )
            }
          </div>
        </div>
        <div class="tile bg-lavender p-5 text-on-accent">
          <p class="font-black">Looking for people to play with here?</p>
          <p class="mt-1 text-sm font-medium">Badie matches players at the same level who are free at the same time. The iPhone app is in testing.</p>
        </div>
      </div>
    </aside>

    {
      others.length > 0 && (
        <section class="min-w-0 lg:col-start-1">
          <div class="flex items-center gap-4">
            <h2 class="eyebrow shrink-0">Nearby courts</h2>
            <span class="h-0.5 flex-1 bg-stroke/15" />
          </div>
          <div class="mt-4 grid grid-cols-1 gap-3 sm:grid-cols-2">
            {others.map(({ venue: other, km }) => <VenueRow venue={other} distanceKm={km} />)}
          </div>
        </section>
      )
    }
  </div>

  <Fragment slot="attribution">
    <p>{sourceNote}{venue.attribution && ` ${venue.attribution}`}</p>
  </Fragment>
</Base>
