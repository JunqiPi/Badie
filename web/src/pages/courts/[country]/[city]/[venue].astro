---
import Base from '../../../../layouts/Base.astro';
import Breadcrumbs from '../../../../components/Breadcrumbs.astro';
import VenueRow from '../../../../components/VenueRow.astro';
import { cityName, countries, englishName, formatAddress, formatPrice, nearby, type City, type Country, type Venue } from '../../../../lib/venues';

export function getStaticPaths() {
  return countries.flatMap((country) =>
    country.cities.flatMap((city) =>
      city.venues.map((venue) => ({
        params: { country: country.code, city: city.slug, venue: venue.slug },
        props: { country, city, venue },
      })),
    ),
  );
}

const { country, city, venue } = Astro.props as { country: Country; city: City; venue: Venue };
const alias = englishName(venue);
const address = formatAddress(venue);
const place = cityName(city);
const others = nearby(venue);

const facts = [
  venue.courts && { label: 'Courts', value: String(venue.courts) },
  venue.price?.perPerson && { label: 'Drop-in', value: `${formatPrice(venue.price.perPerson, venue.country)} per person` },
  venue.price?.perCourtHour && { label: 'Court rental', value: `${formatPrice(venue.price.perCourtHour, venue.country)} per hour` },
  venue.phone && { label: 'Phone', value: venue.phone },
].filter((fact): fact is { label: string; value: string } => Boolean(fact));

const sourceNote = {
  curated: 'Address checked against at least two public sources by the Badie team.',
  openStreetMap: 'From OpenStreetMap. Not yet confirmed by players.',
  openData: 'From government open data.',
}[venue.source];

const site = Astro.site ?? new URL('http://localhost');
const jsonLd = {
  '@context': 'https://schema.org',
  '@graph': [
    {
      '@type': 'SportsActivityLocation',
      name: venue.name,
      alternateName: venue.aliases?.length ? venue.aliases : undefined,
      address: {
        '@type': 'PostalAddress',
        streetAddress: [venue.street, venue.unit].filter(Boolean).join(', ') || undefined,
        addressLocality: venue.city,
        addressRegion: venue.region || undefined,
        postalCode: venue.postcode || undefined,
        addressCountry: venue.country,
      },
      geo: { '@type': 'GeoCoordinates', latitude: venue.lat, longitude: venue.lon },
      telephone: venue.phone,
      sameAs: venue.web,
    },
    {
      '@type': 'BreadcrumbList',
      itemListElement: [
        { name: 'Courts', path: '/courts/' },
        { name: country.name, path: country.path },
        { name: place, path: city.path },
        { name: venue.name, path: venue.path },
      ].map((item, index) => ({ '@type': 'ListItem', position: index + 1, name: item.name, item: new URL(item.path, site).href })),
    },
  ],
};
---

<Base
  title={`${venue.name}${alias ? ` (${alias})` : ''} — badminton in ${place} — Badie`}
  description={`${venue.name}: badminton ${venue.courts ? `with ${venue.courts} courts ` : ''}at ${address}.`}
  noindex={!venue.indexable}
  jsonLd={jsonLd}
>
  <Breadcrumbs
    items={[
      { label: 'Courts', href: '/courts/' },
      { label: country.name, href: country.path },
      { label: place, href: city.path },
    ]}
  />

  <article class="sticker p-6 sm:p-8">
    <div class="flex flex-wrap items-center gap-2">
      <span class="chip bg-lime">Badminton</span>
      {!venue.confirmed && <span class="chip bg-surface-muted">Not yet confirmed</span>}
    </div>
    <h1 class="mt-3 text-3xl font-black leading-tight sm:text-4xl">{venue.name}</h1>
    {alias && <p class="mt-1 text-lg font-bold text-ink-secondary">{alias}</p>}
    <p class="mt-3 text-ink-secondary">{address}</p>

    {
      facts.length > 0 && (
        <dl class="mt-6 grid gap-3 sm:grid-cols-2">
          {facts.map((fact) => (
            <div class="rounded-2xl bg-surface-muted px-4 py-3">
              <dt class="text-xs font-extrabold uppercase tracking-wide text-ink-tertiary">{fact.label}</dt>
              <dd class="text-lg font-extrabold">{fact.value}</dd>
            </div>
          ))}
        </dl>
      )
    }

    <div class="mt-6 flex flex-wrap gap-3">
      <a class="button" href={`https://maps.apple.com/?q=${encodeURIComponent(venue.name)}&ll=${venue.lat},${venue.lon}`}>Apple Maps</a>
      <a class="button button-quiet" href={`https://www.google.com/maps/search/?api=1&query=${venue.lat},${venue.lon}`}>Google Maps</a>
      {venue.web && <a class="button button-quiet" href={venue.web} rel="nofollow noopener">Website</a>}
    </div>
  </article>

  <section class="mt-6 sticker bg-lavender! p-6 text-on-accent">
    <h2 class="text-xl font-black">Looking for people to play with here?</h2>
    <p class="mt-1 font-medium">
      Badie matches players at the same level who are free at the same time. The iPhone app is in testing.
    </p>
  </section>

  {
    others.length > 0 && (
      <section class="mt-10">
        <h2 class="mb-4 text-2xl font-black">Nearby courts</h2>
        <div class="grid grid-cols-1 gap-3 sm:grid-cols-2">
          {others.map(({ venue: other, km }) => <VenueRow venue={other} distanceKm={km} />)}
        </div>
      </section>
    )
  }

  <Fragment slot="attribution">
    <p>{sourceNote}{venue.attribution && ` ${venue.attribution}`}</p>
  </Fragment>
</Base>
