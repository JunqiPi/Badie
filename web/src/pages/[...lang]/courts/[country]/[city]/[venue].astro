---
import Base from '../../../../../layouts/Base.astro';
import Breadcrumbs from '../../../../../components/Breadcrumbs.astro';
import { PinsMap } from '../../../../../app/PinsMap';
import { Icon } from '../../../../../app/icons';
import VenueRow from '../../../../../components/VenueRow.astro';
import { cityName, countries, englishName, facilityLabel, formatAddress, formatPrice, nearby, type City, type Country, type Venue } from '../../../../../lib/venues';
import { languages, localPath, pageLocale, regionName, translator } from '../../../../../lib/static-i18n';

export function getStaticPaths() {
  return languages.flatMap((lang) =>
    countries.flatMap((country) =>
      country.cities.flatMap((city) =>
        city.venues.map((venue) => ({
          params: { lang, country: country.code, city: city.slug, venue: venue.slug },
          props: { country, city, venue },
        })),
      ),
    ),
  );
}

const { country, city, venue } = Astro.props as { country: Country; city: City; venue: Venue };
const alias = englishName(venue);
const address = formatAddress(venue);
const place = cityName(city);
const others = nearby(venue);

const facts = [
  venue.courts && { label: 'courts in total', value: String(venue.courts), tint: 'bg-sky' },
  venue.price?.perPerson !== undefined && { label: 'drop-in per person', value: formatPrice(venue.price.perPerson, venue.country), tint: 'bg-butter' },
  venue.price?.perCourtHour && { label: 'court rental per hour', value: formatPrice(venue.price.perCourtHour, venue.country), tint: 'bg-peach' },
].filter((fact): fact is { label: string; value: string; tint: string } => Boolean(fact));
const pins = [
  { id: venue.id, name: venue.name, lat: venue.lat, lon: venue.lon },
  ...others.map(({ venue: other }) => ({ id: other.id, name: other.name, lat: other.lat, lon: other.lon, href: other.path })),
];
const appleMaps = `https://maps.apple.com/?q=${encodeURIComponent(venue.name)}&ll=${venue.lat},${venue.lon}`;
const googleMaps = `https://www.google.com/maps/search/?api=1&query=${venue.lat},${venue.lon}`;

const t = translator(Astro.url.pathname);
const locale = pageLocale(Astro.url.pathname);
const checked = venue.checked && new Date(`${venue.checked}T12:00:00Z`).toLocaleDateString(locale === 'en' ? 'en-US' : locale, { month: 'long', year: 'numeric' });
const sourceNote = {
  curated: checked
    ? t('Checked against the venue’s official pages by the Badie team in {date}.', { date: checked })
    : t('Address checked against at least two public sources by the Badie team.'),
  openStreetMap: t('From OpenStreetMap. Not yet confirmed by players.'),
  openData: t('From government open data.'),
}[venue.source];

const site = Astro.site ?? new URL('http://localhost');
const jsonLd = {
  '@context': 'https://schema.org',
  '@graph': [
    {
      '@type': 'SportsActivityLocation',
      name: venue.name,
      alternateName: venue.aliases?.length ? venue.aliases : undefined,
      address: {
        '@type': 'PostalAddress',
        streetAddress: [venue.street, venue.unit].filter(Boolean).join(', ') || undefined,
        addressLocality: venue.city,
        addressRegion: venue.region || undefined,
        postalCode: venue.postcode || undefined,
        addressCountry: venue.country,
      },
      geo: { '@type': 'GeoCoordinates', latitude: venue.lat, longitude: venue.lon },
      telephone: venue.phone,
      sameAs: venue.web,
    },
    {
      '@type': 'BreadcrumbList',
      itemListElement: [
        { name: t('Courts'), path: '/courts/' },
        { name: regionName(country.code, locale, country.name), path: country.path },
        { name: place, path: city.path },
        { name: venue.name, path: venue.path },
      ].map((item, index) => ({ '@type': 'ListItem', position: index + 1, name: item.name, item: new URL(localPath(Astro.url.pathname, item.path), site).href })),
    },
  ],
};
---

<Base
  title={t('{name} — badminton in {place} — Badie', { name: alias ? `${venue.name} (${alias})` : venue.name, place })}
  description={venue.courts ? t('{name}: badminton with {n} courts at {address}.', { name: venue.name, n: venue.courts, address }) : t('{name}: badminton at {address}.', { name: venue.name, address })}
  noindex={!venue.indexable}
  jsonLd={jsonLd}
>
  <Breadcrumbs
    items={[
      { label: 'Courts', href: '/courts/' },
      { label: country.name, href: country.path, region: country.code },
      { label: place, href: city.path },
    ]}
  />

  <div class="grid gap-8 lg:grid-cols-[1fr_360px]">
    <header class="min-w-0 lg:col-start-1">
      <div class="flex flex-wrap items-center gap-2">
        <span class="chip bg-lime" data-t={venue.facility ? facilityLabel[venue.facility] : 'Badminton court'}>{venue.facility ? facilityLabel[venue.facility] : 'Badminton court'}</span>
        {venue.confirmed ? <span class="chip bg-mint" data-t="Verified">Verified</span> : <span class="chip bg-surface-muted text-ink" data-t="Not yet confirmed by players">Not yet confirmed by players</span>}
      </div>
      <h1 class="mt-3 text-display break-words lg:text-[2.75rem]">{venue.name}</h1>
      {alias && <p class="mt-1 text-title3 text-ink-secondary">{alias}</p>}
      <p class="mt-2 text-subhead text-ink-secondary">{address}</p>
      {
        facts.length > 0 && (
          <dl class="mt-6 grid grid-cols-3 gap-2 sm:gap-3">
            {facts.map((fact) => (
              <div class:list={['tile flex flex-col-reverse rounded-[14px]! p-3 text-on-accent sm:p-4', fact.tint]}>
                <dt class="mt-1 text-caption sm:text-footnote" data-t={fact.label}>{fact.label}</dt>
                <dd class="text-[1.75rem] leading-none font-black tabular-nums sm:text-[2.5rem]" data-t={fact.value === 'Free' ? 'Free' : undefined}>{fact.value}</dd>
              </div>
            ))}
          </dl>
        )
      }
      {
        venue.playTimes && (
          <div class="sticker mt-6 flex items-start gap-3 p-4 sm:p-5">
            <span aria-hidden="true" class="grid size-11 shrink-0 place-items-center rounded-[13px] border-2 border-stroke bg-peach text-on-accent"><Icon name="clock" /></span>
            <div>
              <p class="text-headline" data-t="Badminton hours">Badminton hours</p>
              <p class="mt-1 font-bold">{venue.playTimes}</p>
              <p class="mt-1 text-footnote text-ink-secondary" data-t="Times change often. Check the official website before you go.">Times change often. Check the official website before you go.</p>
            </div>
          </div>
        )
      }
    </header>

    <aside class="lg:col-start-2 lg:row-span-2 lg:row-start-1">
      <div class="space-y-4 lg:sticky lg:top-24">
        <div class="sticker overflow-hidden">
          <div class="h-60 border-b-2 border-stroke">
            <PinsMap client:visible pins={pins} selected={venue.id} label={t('{name} and {n} nearby courts', { name: venue.name, n: others.length })} />
          </div>
          <div class="p-5">
            <p class="text-headline" data-t="Get there">Get there</p>
            <div class="mt-3 grid gap-2">
              <a class="button" href={appleMaps} data-t="Directions in Apple Maps">Directions in Apple Maps</a>
              <a class="button button-quiet" href={googleMaps} data-t="Google Maps">Google Maps</a>
            </div>
            {
              (venue.web || venue.phone) && (
                <ul class="mt-5 space-y-2 border-t-2 border-stroke/15 pt-4 font-bold">
                  {venue.web && (
                    <li>
                      <a href={venue.web} rel="nofollow noopener" class="link" data-t="Official website">Official website</a>
                    </li>
                  )}
                  {venue.phone && (
                    <li>
                      <a href={`tel:${venue.phone.replace(/[^+\d]/g, '')}`} class="transition-colors hover:text-ink-secondary">
                        {venue.phone}
                      </a>
                    </li>
                  )}
                </ul>
              )
            }
          </div>
        </div>
        <a href="/play/" class="sticker lift block bg-lime p-5 text-on-accent">
          <p class="text-headline" data-t="Looking for people to play with here?">Looking for people to play with here?</p>
          <p class="mt-1 text-footnote" data-t="Badie matches players at the same level who are free at the same time.">Badie matches players at the same level who are free at the same time.</p>
          <p class="button button-sm button-inverse mt-3 inline-flex" data-t="Quick Match">Quick Match</p>
        </a>
      </div>
    </aside>

    {
      others.length > 0 && (
        <section class="min-w-0 lg:col-start-1">
          <h2 class="text-title3" data-t="Nearby courts">Nearby courts</h2>
          <div class="mt-4 grid grid-cols-1 gap-3 sm:grid-cols-2">
            {others.map(({ venue: other, km }) => <VenueRow venue={other} distanceKm={km} />)}
          </div>
        </section>
      )
    }
  </div>

  <Fragment slot="attribution">
    <p>{sourceNote}{venue.attribution && ` ${venue.attribution}`}</p>
  </Fragment>
</Base>
