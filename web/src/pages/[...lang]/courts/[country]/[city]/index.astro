---
import Base from '../../../../../layouts/Base.astro';
import Breadcrumbs from '../../../../../components/Breadcrumbs.astro';
import { PinsMap } from '../../../../../app/PinsMap';
import VenueRow from '../../../../../components/VenueRow.astro';
import { cityName, citySummary, countries, formatPrice, nearbyCities, type City, type Country } from '../../../../../lib/venues';
import { languages, translator } from '../../../../../lib/static-i18n';

export function getStaticPaths() {
  return languages.flatMap((lang) =>
    countries.flatMap((country) =>
      country.cities.map((city) => ({ params: { lang, country: country.code, city: city.slug }, props: { country, city } })),
    ),
  );
}

const { country, city } = Astro.props as { country: Country; city: City };
const name = cityName(city);
const count = city.venues.length;
const summary = citySummary(city);
const neighbours = nearbyCities(city);
const attributions = [...new Set(city.venues.map((v) => v.attribution).filter(Boolean))];
const pins = city.venues.map((v) => ({ id: v.id, name: v.name, lat: v.lat, lon: v.lon, href: v.path }));

const t = translator(Astro.url.pathname);
const facts = [
  t('{n} badminton court is listed in {place}.|{n} badminton courts are listed in {place}.', { n: count, place: name }),
  summary.largest?.courts && t('The largest is {name} with {n} courts.', { name: summary.largest.name, n: summary.largest.courts }),
  summary.cheapest &&
    (summary.cheapest.price!.perPerson === 0
      ? t('{n} list a drop-in price, and some are free.', { n: summary.priced })
      : t('{n} list a drop-in price, from {price} per person.', { n: summary.priced, price: formatPrice(summary.cheapest.price!.perPerson!, summary.cheapest.country) })),
].filter(Boolean);
---

<Base
  title={t('Badminton courts in {place} — Badie', { place: name })}
  description={facts.join(' ')}
  noindex={!city.indexable}
>
  <Breadcrumbs items={[{ label: 'Courts', href: '/courts/' }, { label: country.name, href: country.path, region: country.code }]} />

  <header class="max-w-3xl">
    <p class="text-subhead font-bold text-ink-secondary" data-region={country.code}>{country.name}</p>
    <h1 class="text-display lg:text-[2.75rem]">{name}</h1>
    <p class="mt-3 text-subhead text-ink-secondary">{facts.join(' ')}</p>
  </header>

  <div class="mt-6 grid gap-6 lg:grid-cols-[1fr_26rem]">
    <div class="grid grid-cols-1 content-start gap-3" data-venue-list>
      {city.venues.map((venue) => <VenueRow venue={venue} />)}
    </div>

    <aside class="order-first lg:order-none">
      <div class="grid gap-3 lg:sticky lg:top-24">
        <div class="sticker h-64 overflow-hidden lg:h-80">
          <PinsMap client:visible pins={pins} label={t('Map of courts in {place}', { place: name })} />
        </div>
        {
          summary.totalCourts > 0 && (
            <div class="grid grid-cols-2 gap-3">
              <div class="tile rounded-[14px]! bg-sky p-4 text-on-accent">
                <p class="text-[2rem] leading-none font-black tabular-nums">{count}</p>
                <p class="text-footnote font-bold" data-t="venues">venues</p>
              </div>
              <div class="tile rounded-[14px]! bg-mint p-4 text-on-accent">
                <p class="text-[2rem] leading-none font-black tabular-nums">{summary.totalCourts}</p>
                <p class="text-footnote font-bold" data-t="courts in total">courts in total</p>
              </div>
            </div>
          )
        }
      </div>
    </aside>
  </div>

  {
    neighbours.length > 0 && (
      <section class="mt-14">
        <h2 class="text-title3" data-t="Nearby areas">Nearby areas</h2>
        <ul class="mt-4 flex flex-wrap gap-2">
          {neighbours.map((other) => (
            <li>
              <a href={other.path} class="sticker lift inline-flex items-center gap-2 rounded-full! px-4 py-2 font-bold">
                {cityName(other)}
                <span class="text-ink-tertiary">{other.venues.length}</span>
              </a>
            </li>
          ))}
        </ul>
      </section>
    )
  }

  <Fragment slot="attribution">{attributions.length > 0 && <p>{attributions.join(' · ')}</p>}</Fragment>
</Base>
