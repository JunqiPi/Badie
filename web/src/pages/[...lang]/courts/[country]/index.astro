---
import Base from '../../../../layouts/Base.astro';
import Breadcrumbs from '../../../../components/Breadcrumbs.astro';
import { PinsMap } from '../../../../app/PinsMap';
import { cityName, countries, formatAddress, inCountry, regionLabel, type City, type Country } from '../../../../lib/venues';
import { metros as allMetros } from '../../../../lib/metros';
import { languages, pageLocale, regionName, translator } from '../../../../lib/static-i18n';

export function getStaticPaths() {
  return languages.flatMap((lang) => countries.map((country) => ({ params: { lang, country: country.code }, props: { country } })));
}

const { country } = Astro.props as { country: Country };
const t = translator(Astro.url.pathname);
const place = pageLocale(Astro.url.pathname) === 'en' ? inCountry(country) : regionName(country.code, pageLocale(Astro.url.pathname), country.name);
const venues = country.cities.flatMap((c) => c.venues);
const topCities = country.cities.slice(0, 9);
const alphabetical = (list: City[]) => [...list].sort((a, b) => cityName(a).localeCompare(cityName(b)));
// 地区多的国家按省 / 州分组，每组一张卡片，点开看城市；只有一组时直接列出
const regions = [...Map.groupBy(country.cities, (city) => city.region || '')]
  .map(([name, cities]) => ({ name, cities: alphabetical(cities), count: cities.reduce((n, c) => n + c.venues.length, 0) }))
  .sort((a, b) => b.count - a.count || a.name.localeCompare(b.name));
const grouped = regions.length > 1 && country.cities.length > 12;
const openAll = country.cities.length <= 24;
// 球馆多的国家（德国、法国几千家）地图上每个地区一个点，不然页面太大、手机上画几千个点很卡
const centre = (list: { lat: number; lon: number }[]) => ({
  lat: list.reduce((n, v) => n + v.lat, 0) / list.length,
  lon: list.reduce((n, v) => n + v.lon, 0) / list.length,
});
const pins =
  venues.length > 500
    ? country.cities.map((city) => ({ id: city.path, name: `${cityName(city)} · ${city.venues.length}`, ...centre(city.venues), href: city.path }))
    : venues.map((v) => ({ id: v.id, name: v.name, lat: v.lat, lon: v.lon, href: v.path }));
const attributions = [...new Set(venues.map((v) => v.attribution).filter(Boolean))];
const tints = ['bg-sky', 'bg-peach', 'bg-mint', 'bg-lavender', 'bg-butter', 'bg-pink'];
// 都会区的价格页现在只有美国有
const metros = country.code === 'us' ? allMetros : [];
const zh = pageLocale(Astro.url.pathname) === 'zh-Hans';
---

<Base
  title={t('Badminton courts in {place} — Badie', { place })}
  noindex={country.cities.length === 1}
  description={t('{n} badminton courts across {areas} areas in {place}.', { n: country.venueCount.toLocaleString('en'), areas: country.cities.length, place })}
>
  <Breadcrumbs items={[{ label: 'Courts', href: '/courts/' }]} />

  <section class="grid gap-6 lg:grid-cols-[1fr_1.2fr] lg:items-center">
    <div>
      <p class="text-subhead font-bold text-ink-secondary" data-t="Court directory">Court directory</p>
      <h1 class="text-display lg:text-[2.75rem]" data-region={country.code}>{country.name}</h1>
      <div class="mt-5 grid max-w-md grid-cols-2 gap-3">
        <div class="tile rounded-[14px]! bg-sky p-4 text-on-accent">
          <p class="text-[1.75rem] leading-none font-black whitespace-nowrap tabular-nums sm:text-[2.25rem]">{country.venueCount.toLocaleString('en')}</p>
          <p class="text-footnote font-bold" data-t="courts">courts</p>
        </div>
        <div class="tile rounded-[14px]! bg-peach p-4 text-on-accent">
          <p class="text-[1.75rem] leading-none font-black whitespace-nowrap tabular-nums sm:text-[2.25rem]">{country.cities.length.toLocaleString('en')}</p>
          <p class="text-footnote font-bold" data-t="areas">areas</p>
        </div>
      </div>
    </div>
    <div class="sticker h-72 overflow-hidden sm:h-96">
      <PinsMap client:visible pins={pins} label={t('Map of courts in {place}', { place })} />
    </div>
  </section>

  {
    metros.length > 0 && (
      <section class="mt-14">
        <h2 class="text-title3" data-t="Drop-in prices by metro area">Drop-in prices by metro area</h2>
        <ul class="mt-4 flex flex-wrap gap-2">
          {metros.map((metro) => (
            <li>
              <a href={metro.path} class="sticker lift inline-flex items-center gap-2 rounded-full! px-4 py-2 font-bold">
                {zh ? metro.zh : metro.name}
                <span class="text-ink-tertiary">{metro.venues.length}</span>
              </a>
            </li>
          ))}
        </ul>
      </section>
    )
  }

  <section class="mt-14">
    <h2 class="text-title3" data-t="Areas with the most courts">Areas with the most courts</h2>
    <div class="mt-5 grid grid-cols-1 gap-4 sm:grid-cols-2 lg:grid-cols-3">
      {
        topCities.map((city, index) => (
          <a href={city.path} class="sticker lift flex items-center justify-between gap-4 p-4">
            <div class="min-w-0">
              <p class="truncate text-headline">{cityName(city)}</p>
              <p class="truncate text-footnote text-ink-secondary">{city.venues.slice(0, 2).map((v) => v.name).join(' · ')}</p>
            </div>
            <span class:list={['grid size-12 shrink-0 place-items-center rounded-[14px] border-2 border-stroke text-title3 text-on-accent tabular-nums', tints[index % tints.length]]}>
              {city.venues.length}
            </span>
          </a>
        ))
      }
    </div>
  </section>

  {
    (country.cities.length > topCities.length || country.cities.some((city) => !city.hasPage)) && (
      <section class="mt-14">
        <div class="flex flex-wrap items-center justify-between gap-4">
          <h2 class="text-title3" data-t="All {n} areas" data-n={country.cities.length}>All {country.cities.length.toLocaleString('en')} areas</h2>
          <label class="w-full sm:w-56">
            <span class="sr-only" data-t="Filter areas">Filter areas</span>
            <input data-area-filter type="search" placeholder="Filter areas" data-t-placeholder="Filter areas" class="field" />
          </label>
        </div>
        <div class="mt-5 grid grid-cols-1 items-start gap-4 sm:grid-cols-2 lg:grid-cols-3">
          {(grouped ? regions : [{ name: '', cities: alphabetical(country.cities), count: country.venueCount }]).map((region, index) => (
            <details data-region-group open={openAll || !grouped} class="group/region sticker overflow-hidden open:col-span-full">
              <summary class:list={['flex cursor-pointer items-center justify-between gap-3 px-4 py-3', !grouped && 'sr-only']}>
                <span class="min-w-0">
                  <span class="block truncate text-headline">{regionLabel(country.code, region.name)}</span>
                  <span class="block text-footnote font-bold text-ink-secondary" data-t="{n} courts in {areas} areas" data-n={region.count} data-areas={region.cities.length}>
                    {region.count.toLocaleString('en')} courts in {region.cities.length} areas
                  </span>
                </span>
                <span class:list={['grid size-10 shrink-0 place-items-center rounded-[12px] border-2 border-stroke text-headline text-on-accent tabular-nums', tints[index % tints.length]]}>
                  {region.count}
                </span>
              </summary>
              <ul class:list={['columns-1 gap-6 px-2 pb-3 sm:group-open/region:columns-2 lg:group-open/region:columns-3', grouped ? 'border-t-2 border-stroke/10 pt-2' : 'pt-3']}>
                {region.cities.map((city) => (
                  <li data-area={cityName(city).toLowerCase()} class="break-inside-avoid">
                    {city.hasPage ? (
                      <a href={city.path} class="flex justify-between gap-3 rounded-[10px] px-2 py-1.5 font-bold transition-colors hover:bg-surface">
                        <span class="truncate">{city.name}</span>
                        <span class="shrink-0 text-ink-tertiary tabular-nums">{city.venues.length}</span>
                      </a>
                    ) : (
                      // 不单独成页的小地方（一两家）：球馆直接列在这里，点开是地图
                      <div id={`area-${city.slug}`} class="scroll-mt-28 px-2 py-1.5 target:rounded-[10px] target:bg-lime/30">
                        <p class="text-footnote font-bold text-ink-secondary">{city.name}</p>
                        <ul class="mt-0.5 grid gap-1">
                          {city.venues.map((venue) => (
                            <li>
                              <a href={venue.path} rel="noopener" class="group/venue block">
                                <span class="block font-bold leading-snug group-hover/venue:underline">{venue.name}</span>
                                <span class="block truncate text-footnote text-ink-secondary">{formatAddress(venue)}</span>
                              </a>
                            </li>
                          ))}
                        </ul>
                      </div>
                    )}
                  </li>
                ))}
              </ul>
            </details>
          ))}
        </div>
      </section>
    )
  }

  <Fragment slot="attribution">{attributions.length > 0 && <p>{attributions.join(' · ')}</p>}</Fragment>
</Base>

<script>
  const input = document.querySelector<HTMLInputElement>('[data-area-filter]');
  const groups = [...document.querySelectorAll<HTMLDetailsElement>('[data-region-group]')];
  const initiallyOpen = groups.map((group) => group.open);
  input?.addEventListener('input', () => {
    const query = input.value.trim().toLowerCase();
    groups.forEach((group, index) => {
      let matches = 0;
      for (const item of group.querySelectorAll<HTMLElement>('[data-area]')) {
        item.hidden = !item.dataset.area!.includes(query);
        if (!item.hidden) matches++;
      }
      group.hidden = matches === 0;
      group.open = query ? matches > 0 : initiallyOpen[index];
    });
  });
  // 从别处链接到某个小地方（#area-…）：展开它所在的省 / 州和它自己
  const openArea = () => {
    const target = location.hash ? document.getElementById(decodeURIComponent(location.hash.slice(1))) : null;
    const group = target?.closest<HTMLDetailsElement>('[data-region-group]');
    if (!target || !group) return;
    group.open = true;
    target.scrollIntoView({ block: 'center' });
  };
  openArea();
  window.addEventListener('hashchange', openArea);
</script>
