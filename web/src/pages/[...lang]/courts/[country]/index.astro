---
import Base from '../../../../layouts/Base.astro';
import Breadcrumbs from '../../../../components/Breadcrumbs.astro';
import { PinsMap } from '../../../../app/PinsMap';
import { cityName, countries, inCountry, type Country } from '../../../../lib/venues';
import { languages, pageLocale, regionName, translator } from '../../../../lib/static-i18n';

export function getStaticPaths() {
  return languages.flatMap((lang) => countries.map((country) => ({ params: { lang, country: country.code }, props: { country } })));
}

const { country } = Astro.props as { country: Country };
const t = translator(Astro.url.pathname);
const place = pageLocale(Astro.url.pathname) === 'en' ? inCountry(country) : regionName(country.code, pageLocale(Astro.url.pathname), country.name);
const venues = country.cities.flatMap((c) => c.venues);
const topCities = country.cities.slice(0, 9);
const alphabetical = [...country.cities].sort((a, b) => cityName(a).localeCompare(cityName(b)));
const attributions = [...new Set(venues.map((v) => v.attribution).filter(Boolean))];
const tints = ['bg-sky', 'bg-peach', 'bg-mint', 'bg-lavender', 'bg-butter', 'bg-pink'];
---

<Base
  title={t('Badminton courts in {place} — Badie', { place })}
  noindex={country.cities.length === 1}
  description={t('{n} badminton courts across {areas} areas in {place}.', { n: country.venueCount.toLocaleString('en'), areas: country.cities.length, place })}
>
  <Breadcrumbs items={[{ label: 'Courts', href: '/courts/' }]} />

  <section class="grid gap-6 lg:grid-cols-[1fr_1.2fr] lg:items-center">
    <div>
      <p class="text-subhead font-bold text-ink-secondary" data-t="Court directory">Court directory</p>
      <h1 class="text-display lg:text-[2.75rem]" data-region={country.code}>{country.name}</h1>
      <div class="mt-5 grid max-w-md grid-cols-2 gap-3">
        <div class="tile rounded-[14px]! bg-sky p-4 text-on-accent">
          <p class="text-[2.25rem] leading-none font-black tabular-nums">{country.venueCount.toLocaleString('en')}</p>
          <p class="text-footnote font-bold" data-t="courts">courts</p>
        </div>
        <div class="tile rounded-[14px]! bg-peach p-4 text-on-accent">
          <p class="text-[2.25rem] leading-none font-black tabular-nums">{country.cities.length.toLocaleString('en')}</p>
          <p class="text-footnote font-bold" data-t="areas">areas</p>
        </div>
      </div>
    </div>
    <div class="sticker h-72 overflow-hidden sm:h-96">
      <PinsMap client:visible pins={venues.map((v) => ({ id: v.id, name: v.name, lat: v.lat, lon: v.lon, href: v.path }))} label={t('Map of courts in {place}', { place })} />
    </div>
  </section>

  <section class="mt-14">
    <h2 class="text-title3" data-t="Areas with the most courts">Areas with the most courts</h2>
    <div class="mt-5 grid grid-cols-1 gap-4 sm:grid-cols-2 lg:grid-cols-3">
      {
        topCities.map((city, index) => (
          <a href={city.path} class="sticker lift flex items-center justify-between gap-4 p-4">
            <div class="min-w-0">
              <p class="truncate text-headline">{cityName(city)}</p>
              <p class="truncate text-footnote text-ink-secondary">{city.venues.slice(0, 2).map((v) => v.name).join(' · ')}</p>
            </div>
            <span class:list={['grid size-12 shrink-0 place-items-center rounded-[14px] border-2 border-stroke text-title3 text-on-accent tabular-nums', tints[index % tints.length]]}>
              {city.venues.length}
            </span>
          </a>
        ))
      }
    </div>
  </section>

  {
    country.cities.length > topCities.length && (
      <section class="mt-14">
        <div class="flex flex-wrap items-center justify-between gap-4">
          <h2 class="text-title3" data-t="All {n} areas A–Z" data-n={country.cities.length}>All {country.cities.length.toLocaleString('en')} areas A–Z</h2>
          <label class="w-full sm:w-56">
            <span class="sr-only" data-t="Filter areas">Filter areas</span>
            <input data-area-filter type="search" placeholder="Filter areas" data-t-placeholder="Filter areas" class="field" />
          </label>
        </div>
        <details data-area-list open={country.cities.length <= 60} class="mt-5">
          <summary class="link inline-block cursor-pointer py-1" data-t="Show all areas">Show all areas</summary>
          <ul class="mt-4 columns-1 gap-8 sm:columns-2 lg:columns-3">
            {alphabetical.map((city) => (
              <li data-area={cityName(city).toLowerCase()} class="break-inside-avoid">
                <a href={city.path} class="flex justify-between gap-3 rounded-[10px] px-2 py-1.5 font-bold transition-colors hover:bg-surface">
                  <span class="truncate">{cityName(city)}</span>
                  <span class="text-ink-tertiary">{city.venues.length}</span>
                </a>
              </li>
            ))}
          </ul>
        </details>
      </section>
    )
  }

  <Fragment slot="attribution">{attributions.length > 0 && <p>{attributions.join(' · ')}</p>}</Fragment>
</Base>

<script>
  const input = document.querySelector<HTMLInputElement>('[data-area-filter]');
  const list = document.querySelector<HTMLDetailsElement>('[data-area-list]');
  input?.addEventListener('input', () => {
    const query = input.value.trim().toLowerCase();
    if (list && query) list.open = true;
    for (const item of document.querySelectorAll<HTMLElement>('[data-area]')) {
      item.hidden = !item.dataset.area!.includes(query);
    }
  });
</script>
