---
import App from '../layouts/App.astro';
import { allVenues, countries } from '../lib/venues';

const courtCount = allVenues.length.toLocaleString('en');
---

<App
  title="Badie — find badminton partners and courts"
  description={`Find badminton partners at your level and browse ${courtCount} badminton courts. Free, no ads, nonprofit.`}
>
  <h1 class="display text-5xl">Up for a game tonight?</h1>
  <p class="max-w-prose text-lg">
    Badie matches you with badminton players at your level who are free when you are, at courts you can actually get to. Free, nonprofit, no ads.
  </p>
  <ol class="grid max-w-prose gap-2">
    <li><strong>Set your level.</strong> A 2-minute quiz places you on a 1–9 scale.</li>
    <li><strong>Get matched.</strong> Pick your courts and when you’re free.</li>
    <li><strong>Play, then confirm.</strong> Both sides confirm the result for win rate and leaderboards.</li>
  </ol>
  <ul class="grid gap-1">
    <li><a class="link" href="/courts/">{courtCount} badminton courts in {countries.length} countries</a></li>
    <li><a class="link" href="/levels/">Badminton level chart (1–9)</a></li>
    <li><a class="link" href="/about/">About Badie</a></li>
  </ul>
</App>
