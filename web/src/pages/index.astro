---
import App from '../layouts/App.astro';
import { allVenues, countries } from '../lib/venues';

const courtCount = allVenues.length.toLocaleString('en');
---

<App
  title="Badie — find badminton partners and courts"
  description={`No need to ask strangers for a game: Badie finds badminton partners at your level for you. Browse ${courtCount} badminton courts. Free to use.`}
>
  <h1 class="display text-5xl">Badminton buddy? Find one today!</h1>
  <p class="max-w-prose text-lg">Badie finds players at your level near you. Free.</p>
  <ol class="grid max-w-prose gap-2">
    <li>Set your level</li>
    <li>Get matched</li>
    <li>Play, then confirm</li>
  </ol>
  <ul class="grid gap-1">
    <li><a class="link" href="/courts/">{courtCount} badminton courts in {countries.length} countries</a></li>
    <li><a class="link" href="/levels/">Badminton level chart (1–9)</a></li>
    <li><a class="link" href="/about/">About Badie</a></li>
  </ul>
</App>
