---
import Base from '../layouts/Base.astro';
import { allVenues, countries } from '../lib/venues';

const steps = [
  { title: 'Set your level and courts', body: 'A short questionnaire places you on a 1–9 scale. Pick the courts you can get to.', color: 'bg-lavender' },
  { title: 'Get matched', body: 'Badie finds players at your level who are free at the same time, at a court that suits everyone.', color: 'bg-peach' },
  { title: 'Play and confirm', body: 'After the game both sides confirm the result. Only matching results count toward win rate.', color: 'bg-mint' },
];
---

<Base
  title="Badie — find badminton partners and courts"
  description={`Find badminton partners at your level and browse ${allVenues.length.toLocaleString('en')} badminton courts. Free and nonprofit.`}
>
  <section class="py-10 sm:py-16">
    <h1 class="max-w-3xl text-4xl font-black leading-tight sm:text-6xl">
      Find someone to play <span class="rounded-xl bg-lime px-2 text-on-accent">badminton</span> with tonight.
    </h1>
    <p class="mt-5 max-w-2xl text-lg text-ink-secondary">
      Badie matches you with players at your level at courts near you. Free, no ads, run as a nonprofit. The iPhone app is in
      testing; meanwhile, browse {allVenues.length.toLocaleString('en')} courts in {countries.length} countries.
    </p>
    <a href="/courts/" class="button mt-8">Browse courts</a>
  </section>

  <section class="grid gap-4 sm:grid-cols-3">
    {
      steps.map((step, index) => (
        <div class="sticker p-5">
          <span class:list={['chip', step.color]}>Step {index + 1}</span>
          <h2 class="mt-3 text-lg font-extrabold">{step.title}</h2>
          <p class="mt-1 text-ink-secondary">{step.body}</p>
        </div>
      ))
    }
  </section>

  <section class="mt-14">
    <h2 class="text-2xl font-black">Courts by country</h2>
    <div class="mt-4 grid gap-3 sm:grid-cols-2 lg:grid-cols-3">
      {
        countries.map((country) => (
          <a href={country.path} class="sticker flex items-center justify-between p-4 hover:-translate-y-0.5">
            <span class="font-extrabold">{country.name}</span>
            <span class="text-sm font-bold text-ink-tertiary">{country.venueCount.toLocaleString('en')}</span>
          </a>
        ))
      }
    </div>
  </section>
</Base>
