---
import '../../styles/global.css';
import App from '../../app/App';
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <meta name="robots" content="noindex" />
    <meta name="color-scheme" content="light dark" />
    <title>Badie</title>
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
  </head>
  <body class="min-h-dvh bg-canvas antialiased">
    <App client:only="react">
      <p slot="fallback" role="status" class="grid min-h-dvh place-items-center font-bold text-ink-secondary">
        <span class="flex items-center gap-3">
          <span aria-hidden="true" class="size-5 animate-spin rounded-full border-[3px] border-current border-t-transparent"></span>
          Loading…
        </span>
      </p>
    </App>
  </body>
</html>
