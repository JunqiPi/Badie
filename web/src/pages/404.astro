---
import Base from '../layouts/Base.astro';
import CourtSearch from '../components/CourtSearch.astro';
---

<Base title="Page not found — Badie" description="This page doesn’t exist. Search for badminton courts instead." noindex>
  <section class="grid gap-8 py-6 lg:grid-cols-[1fr_1fr] lg:items-end">
    <div>
      <p class="eyebrow">404</p>
      <h1 class="display mt-3 text-[clamp(3rem,7vw,5.5rem)]">Page not found</h1>
      <p class="mt-4 text-lg text-ink-secondary">This page doesn’t exist or has moved. Search for a court instead.</p>
      <div class="mt-6 flex flex-wrap gap-2">
        <a class="button" href="/courts/">Browse courts</a>
        <a class="button button-quiet" href="/">Home</a>
      </div>
    </div>
    <CourtSearch />
  </section>
</Base>
