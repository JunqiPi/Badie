# Cloudflare Pages 响应头。页面里的脚本白名单在 astro.config.ts 的 CSP 里（meta 标签不能设置 frame-ancestors，所以这里补上）
/*
  X-Content-Type-Options: nosniff
  X-Frame-Options: DENY
  Content-Security-Policy: frame-ancestors 'none'
  Referrer-Policy: strict-origin-when-cross-origin
  Permissions-Policy: geolocation=(self), camera=(), microphone=(), payment=(), usb=(), interest-cohort=()
  Strict-Transport-Security: max-age=31536000; includeSubDomains

# 推送的 service worker 每次都检查有没有新版本
/sw.js
  Cache-Control: no-cache

# 个人页面不进搜索引擎
/signin/*
  X-Robots-Tag: noindex
/play/*
  X-Robots-Tag: noindex
/games/*
  X-Robots-Tag: noindex
/rooms/*
  X-Robots-Tag: noindex
/groups/*
  X-Robots-Tag: noindex
/join/*
  X-Robots-Tag: noindex
/challenges/*
  X-Robots-Tag: noindex
/rankings/*
  X-Robots-Tag: noindex
/messages/*
  X-Robots-Tag: noindex
/notifications/*
  X-Robots-Tag: noindex
/players/*
  X-Robots-Tag: noindex
/me/*
  X-Robots-Tag: noindex
/settings/*
  X-Robots-Tag: noindex
/verification/*
  X-Robots-Tag: noindex
/level-quiz/*
  X-Robots-Tag: noindex
/admin/*
