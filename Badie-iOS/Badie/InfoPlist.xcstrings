    "CFBundleName" : {
      "comment" : "Bundle name",
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Badie"
          }
        }
      }
    },
    "NSLocationWhenInUseUsageDescription" : {
      "comment" : "Privacy - Location When In Use Usage Description",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Badie uses your location to show courts, games and players near you, and how far away the courts are. Your location isn’t saved."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "आपके आस-पास के कोर्ट, गेम और खिलाड़ी दिखाने, और कोर्ट की दूरी बताने के लिए। आपकी लोकेशन सेव नहीं की जाती।"
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Digunakan untuk menampilkan lapangan, game, dan pemain di sekitarmu, serta jarak ke lapangan. Lokasimu tidak disimpan."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "近くのコート、ゲーム、プレイヤーと、コートまでの距離を表示するために使います。位置情報は保存しません。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "주변 코트, 게임, 플레이어와 코트까지의 거리를 보여 주는 데 사용해요. 위치는 저장하지 않아요."
          }
        },
        "ms" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Digunakan untuk menunjukkan gelanggang, permainan dan pemain berdekatan, serta jarak ke gelanggang. Lokasi anda tidak disimpan."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ใช้เพื่อแสดงสนาม เกม และผู้เล่นใกล้คุณ พร้อมระยะทางไปยังสนาม ระบบไม่บันทึกตำแหน่งของคุณ"
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dùng để hiển thị sân, trận và người chơi gần bạn, cùng khoảng cách đến sân. Vị trí của bạn không được lưu."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "用于显示附近的球馆、球局和球友，以及球馆离你多远。位置不会保存。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "用於顯示附近的球館、球局和球友，以及球館離你多遠。位置不會儲存。"
          }
        }
      }
    }
  },
  "version" : "1.0"
}
