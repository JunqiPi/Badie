    "知道平高球和高远球的区别，知道什么时候打哪种，能控制弧度和落点" : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Knows attacking clears from high clears and when to use each; controls height and placement"
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "अटैकिंग क्लियर और हाई क्लियर का फ़र्क और कब कौन-सा खेलना है, जानते हैं; ऊँचाई और प्लेसमेंट पर कंट्रोल"
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Paham beda clear menyerang dan clear tinggi serta kapan memakainya; mengontrol tinggi dan penempatan"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ドリブンクリアとハイクリアの違いと使いどころがわかり、高さとコースをコントロールできる"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "드리븐 클리어와 하이 클리어의 차이와 쓸 때를 알고, 높이와 코스를 조절할 수 있음"
          }
        },
        "ms" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Faham beza clear menyerang dan clear tinggi serta bila menggunakannya; mengawal ketinggian dan penempatan"
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "รู้ความต่างของลูกโด่งบุกกับลูกโด่ง และรู้ว่าเมื่อไหร่ควรตีแบบไหน คุมความสูงและตำแหน่งลูกได้"
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Phân biệt phông cầu tấn công với phông cầu cao sâu và biết khi nào dùng loại nào; kiểm soát được độ cao và điểm rơi"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "知道平高球和高遠球的區別，知道什麼時候打哪種，能控制弧度和落點"
          }
        }
      }
    },
    "知道怎么往下压，但力量打不透" : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Knows how to hit down, but can’t put power through the shuttle"
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "नीचे मारना जानते हैं, पर ताक़त शटल तक नहीं पहुँचा पाते"
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tahu cara memukul ke bawah, tapi tenaganya belum tersalur ke kok"
