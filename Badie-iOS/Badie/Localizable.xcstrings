    "能区分垫步、跨步，全场六个点能走到但不流畅" : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Knows chassé vs. lunge steps; can reach all six corners, but not smoothly"
          }
        }
      }
    },
    "能区分手臂和手腕发力，对内旋、外旋有基本概念" : {
      "localizations" : {
