    "一般 %lld 个工作日内审核完，结果会发到通知里。" : {
      "localizations" : {
        "en" : {
          "variations" : {
            "plural" : {
              "one" : {
                "stringUnit" : {
                  "state" : "translated",
                  "value" : "Reviews usually take up to %lld business day. You'll get the result in your notifications."
                }
              },
              "other" : {
                "stringUnit" : {
                  "state" : "translated",
                  "value" : "Reviews usually take up to %lld business days. You'll get the result in your notifications."
                }
              }
            }
          }
        },
        "hi" : {
          "variations" : {
            "plural" : {
              "one" : {
                "stringUnit" : {
                  "state" : "translated",
                  "value" : "रिव्यू में आम तौर पर %lld कामकाजी दिन लगता है। नतीजा आपको नोटिफ़िकेशन में मिलेगा।"
                }
              },
              "other" : {
                "stringUnit" : {
                  "state" : "translated",
                  "value" : "रिव्यू में आम तौर पर %lld कामकाजी दिन तक लगते हैं। नतीजा आपको नोटिफ़िकेशन में मिलेगा।"
                }
              }
            }
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Peninjauan biasanya selesai dalam %lld hari kerja. Hasilnya akan masuk ke notifikasimu."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
