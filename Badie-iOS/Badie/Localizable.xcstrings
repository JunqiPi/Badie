        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "知道要把球打到對方難接的地方，但多數時候還做不到"
          }
        }
      }
    },
    "知道进攻前后站、防守左右站" : {
