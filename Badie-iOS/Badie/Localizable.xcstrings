          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ลูกรุกดีทุกแบบ (ทุกทักษะถึงระดับ 4 รวมแบ็คแฮนด์) มีความเข้าใจประเภทคู่เบื้องต้น แต่รับลูกที่ถูกกดดันหรือลูกสุดตัวไม่ได้"
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Đánh tốt mọi cú tấn công (mọi kỹ năng đạt cấp 4, kể cả trái tay), có ý thức đánh đôi cơ bản; nhưng chưa xử lý được cú chống đỡ hay cầu cứu nguy"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
