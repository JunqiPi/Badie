    "已报名的场次会一并取消，名额让给候补。" : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sessions you've signed up for will also be canceled, and your spots go to the waitlist."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "जिन सेशन के लिए आपने साइन अप किया है वे भी कैंसिल होंगे, और आपकी जगहें वेटलिस्ट वालों को मिलेंगी।"
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sesi yang sudah kamu daftar juga akan dibatalkan, dan slotmu diberikan ke daftar tunggu."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "参加登録した回もあわせてキャンセルされ、枠はキャンセル待ちの人に回ります。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "신청한 일정도 함께 취소되고 자리는 대기자에게 넘어가요."
          }
        },
        "ms" : {
          "stringUnit" : {
            "state" : "translated",
