      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Games at a set time and venue. Sign up in one tap. When it's full, you're waitlisted, and spots fill automatically when someone drops out."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "तय समय और वेन्यू पर होने वाले गेम। एक टैप में साइन अप करें। भर जाने पर आप वेटलिस्ट में जाते हैं, और किसी के हटते ही जगह अपने-आप भर जाती है।"
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Game di waktu dan GOR tetap. Daftar sekali ketuk. Kalau penuh, kamu masuk daftar tunggu, dan slot otomatis terisi kalau ada yang mundur."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "決まった時間と会場で行うゲームです。ワンタップで参加登録でき、満員ならキャンセル待ちになり、キャンセルが出たら自動で繰り上がります。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "정해진 시간과 체육관에서 열리는 모임이에요. 탭 한 번으로 신청하고, 다 차면 대기 명단에 올라가요. 빠지는 사람이 생기면 자동으로 채워져요."
          }
        },
        "ms" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Permainan pada masa dan gelanggang yang tetap. Daftar dengan satu ketikan. Apabila penuh, anda masuk senarai menunggu, dan tempat diisi automatik apabila ada yang menarik diri."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "เกมเวลาเดิม สนามเดิม ลงชื่อได้ในแตะเดียว ถ้าเต็มคุณจะอยู่ในรายชื่อสำรอง และเมื่อมีคนถอนตัว ที่ว่างจะถูกเติมอัตโนมัติ"
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Các buổi chơi cố định giờ và sân. Đăng ký bằng một chạm. Khi hết chỗ, bạn sẽ vào danh sách chờ và tự động được thêm vào khi có người rút."
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "固定時間、固定球館的局：一鍵報名，額滿自動候補，有人退出自動遞補。"
          }
        }
      }
    },
