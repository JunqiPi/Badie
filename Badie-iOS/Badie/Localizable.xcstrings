    "劈吊、滑板都会，但稳定性不足，球速也不够，偶尔反而陷入被动" : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Has both sliced drops and reverse slices, but not consistent or fast enough, and sometimes ends up under pressure"
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "स्लाइस्ड ड्रॉप और रिवर्स स्लाइस दोनों आते हैं, पर स्थिरता और रफ़्तार कम है; कभी-कभी उल्टा दबाव में आ जाते हैं"
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bisa sliced drop dan reverse slice, tapi belum stabil dan kurang cepat; kadang malah jadi tertekan"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "カットもリバースカットも打てるが、安定性もスピードも足りず、かえって不利になることもある"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "커트와 리버스 커트 모두 치지만 안정성과 속도가 부족해 가끔 오히려 수세에 몰려요"
          }
        },
        "ms" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Boleh buat sliced drop dan reverse slice, tetapi kurang stabil dan kurang laju; kadangkala jadi tertekan"
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ตัดหยอดและหยอดสไลซ์กลับได้ทั้งสองแบบ แต่ยังไม่นิ่งและลูกยังไม่เร็วพอ บางทีกลับเสียเปรียบ"
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Đánh được cả cắt cầu và cắt ngược nhưng chưa ổn định, tốc độ chưa đủ, đôi khi còn bị rơi vào thế bị động"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "劈吊、滑板都會，但穩定性不足，球速也不夠，偶爾反而陷入被動"
          }
        }
      }
    },
    "劈吊、滑板都熟练，和高远、杀球动作一致，球速快、过网就落" : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sliced drops and reverse slices are fluent, disguised like clears and smashes, and fast, dropping right after the net"
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "स्लाइस्ड ड्रॉप और रिवर्स स्लाइस में सहज, क्लियर और स्मैश जैसा एक्शन; तेज़, नेट पार करते ही गिरती है"
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Lancar sliced drop dan reverse slice, gerakannya mirip clear dan smash, cepat dan langsung jatuh setelah net"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "カットもリバースカットも得意で、クリアやスマッシュと同じフォーム。速く、ネットを越えてすぐ落ちる"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "커트와 리버스 커트 모두 능숙하고 클리어·스매시와 동작이 같으며, 빠르고 네트를 넘자마자 떨어짐"
          }
        },
        "ms" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mahir sliced drop dan reverse slice, gaya sama seperti clear dan smash, laju dan terus jatuh selepas jaring"
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ตัดหยอดและหยอดสไลซ์กลับได้คล่อง ท่าเหมือนลูกโด่งและลูกตบ ลูกเร็ว ข้ามเน็ตแล้วตกทันที"
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Thành thạo cắt cầu và cắt ngược, động tác giống hệt phông cầu và đập cầu, cầu nhanh và rơi ngay sau lưới"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "劈吊、滑板都熟練，和高遠球、殺球動作一致，球速快、過網就落"
          }
        }
      }
    },
    "加个球友，下次直接约。" : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Add them as a friend so you can play again directly."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "इन्हें दोस्त बनाएँ ताकि अगली बार सीधे खेल सकें।"
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tambahkan sebagai teman agar bisa langsung main lagi."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "友達に追加すれば、次から直接誘えます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "친구를 추가하면 다음엔 바로 게임을 잡을 수 있어요."
          }
        },
        "ms" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tambah dia sebagai rakan supaya boleh main lagi terus."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "เพิ่มเป็นเพื่อน แล้วครั้งหน้านัดกันได้โดยตรง"
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kết bạn để lần sau hẹn trực tiếp."
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "加個球友，下次直接約。"
          }
        }
      }
    },
    "加为球友后才能私信。可以先发好友申请，或在球局、球群里聊" : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "You can only message friends. Send a friend request first, or chat in a game or group"
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "सिर्फ़ दोस्तों को मैसेज कर सकते हैं। पहले फ़्रेंड रिक्वेस्ट भेजें, या किसी गेम या ग्रुप में चैट करें"
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kamu hanya bisa mengirim pesan ke teman. Kirim permintaan pertemanan dulu, atau chat di game atau grup"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "メッセージは友達にのみ送れます。まず友達リクエストを送るか、ゲームやグループでチャットしてください"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "친구만 메시지를 보낼 수 있어요. 먼저 친구 요청을 보내거나 게임·그룹에서 대화하세요"
          }
        },
        "ms" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Anda hanya boleh menghantar mesej kepada rakan. Hantar permintaan rakan dahulu, atau bersembang dalam permainan atau kumpulan"
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ส่งข้อความส่วนตัวได้เฉพาะเพื่อน ส่งคำขอเป็นเพื่อนก่อน หรือคุยในเกมหรือกลุ่ม"
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Chỉ nhắn tin riêng được với bạn bè. Hãy gửi lời mời kết bạn trước, hoặc trò chuyện trong trận hay nhóm"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "加為球友後才能私訊。可以先送出好友申請，或在球局、球群裡聊"
          }
        }
      }
    },
    "加为球友后才能私信。陌生人不能直接发消息，是为了少一点骚扰和骗局。" : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "You can only message friends. Strangers can't message you directly, which cuts down on harassment and scams."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "सिर्फ़ दोस्तों को मैसेज कर सकते हैं। अजनबी आपको सीधे मैसेज नहीं कर सकते, जिससे परेशानी और धोखाधड़ी कम होती है।"
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kamu hanya bisa mengirim pesan ke teman. Orang asing tidak bisa langsung mengirimimu pesan, agar gangguan dan penipuan berkurang."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "メッセージは友達にのみ送れます。知らない人から直接メッセージが届かないようにして、迷惑行為や詐欺を減らしています。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "친구만 메시지를 보낼 수 있어요. 모르는 사람이 바로 메시지를 못 보내게 해서 괴롭힘과 사기를 줄여요."
          }
        },
        "ms" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Anda hanya boleh menghantar mesej kepada rakan. Orang asing tidak boleh terus menghantar mesej kepada anda, untuk mengurangkan gangguan dan penipuan."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ส่งข้อความส่วนตัวได้เฉพาะเพื่อน คนแปลกหน้าส่งข้อความหาคุณโดยตรงไม่ได้ เพื่อลดการก่อกวนและการหลอกลวง"
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Chỉ nhắn tin riêng được với bạn bè. Người lạ không thể nhắn trực tiếp cho bạn, giúp giảm quấy rối và lừa đảo."
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "加為球友後才能私訊。陌生人不能直接傳訊息，是為了減少騷擾和詐騙。"
          }
        }
      }
    },
