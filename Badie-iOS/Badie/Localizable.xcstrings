    "TA 只接受水平相近的挑战" : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "They only accept challenges from players at a similar level"
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ये सिर्फ़ मिलते-जुलते लेवल वालों के चैलेंज लेते हैं"
          }
