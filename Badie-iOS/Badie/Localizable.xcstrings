    "放网基本能控制，搓球、勾对角刚开始用，失误多" : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Basic control on net drops; just starting net spins and cross-court net shots, with many errors"
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "नेट ड्रॉप पर बुनियादी कंट्रोल; नेट स्पिन और क्रॉस-कोर्ट नेट शॉट अभी शुरू किए हैं, गलतियाँ ज़्यादा"
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kontrol dasar netting tipis; baru mulai netting spin dan netting silang, masih banyak salah"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ネットショットはある程度コントロールできる。ヘアピンとクロスネットは使い始めでミスが多い"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "네트 드롭은 기본적으로 컨트롤되지만 헤어핀과 크로스 헤어핀은 이제 막 쓰기 시작해 실수가 많아요"
          }
        },
        "ms" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kawalan asas pada net drop; baru mula guna netting dan pukulan silang di jaring, banyak kesilapan"
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "เขี่ยหน้าเน็ตคุมได้พื้นฐาน ปั่นหน้าเน็ตและลูกทแยงเพิ่งเริ่มใช้ เสียบ่อย"
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Đặt cầu lưới kiểm soát cơ bản; mới bắt đầu vê cầu và chéo lưới, còn nhiều lỗi"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "放網基本能控制，搓球、勾對角剛開始用，失誤多"
          }
        }
      }
    },
