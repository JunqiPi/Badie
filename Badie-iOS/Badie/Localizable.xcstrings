    "业余球友看来稳得可怕，和顶尖高手只差毫厘" : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Scarily consistent to amateurs, a hair away from top players"
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "शौकिया खिलाड़ियों के लिए गज़ब के स्थिर, टॉप खिलाड़ियों से बस ज़रा-सा पीछे"
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sangat konsisten di mata pemain amatir, tinggal selangkah dari pemain top"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "アマチュアから見ると恐ろしく安定、トップ選手とはわずかな差"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "아마추어가 보기엔 무서울 만큼 안정적이고, 최상위 고수와는 종이 한 장 차이"
          }
        },
        "ms" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Konsisten menakutkan bagi pemain amatur, hampir setaraf pemain terbaik"
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "สำหรับมือสมัครเล่นคือนิ่งจนน่ากลัว ห่างจากมือระดับท็อปแค่นิดเดียว"
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ổn định đáng sợ với người chơi phong trào, chỉ kém cao thủ hàng đầu một chút"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "業餘球友看來穩得可怕，和頂尖高手只差毫釐"
          }
        }
      }
    },
