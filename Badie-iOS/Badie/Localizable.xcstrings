        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ヘアピン、クロスネット、プッシュ、ネットキルを使いこなし、実戦でも使える"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "헤어핀, 크로스 헤어핀, 푸시, 네트 킬 모두 능숙하고 실전에서 사용해요"
          }
        },
        "ms" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Netting, pukulan silang di jaring, tolakan dan kill di jaring lancar dalam permainan sebenar"
          }
