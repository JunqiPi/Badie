        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "아래로 치는 법은 알지만 힘을 셔틀콕에 제대로 싣지 못해요"
          }
        },
        "ms" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tahu cara pukul ke bawah, tetapi kuasa belum sampai ke bulu tangkis"
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "รู้วิธีกดลูกลง แต่ส่งแรงไปถึงลูกไม่ได้"
