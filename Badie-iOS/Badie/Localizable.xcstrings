    "%lld 道题，按你能稳定做到的选，自动算出你的等级（细分到 −、本级、+）" : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%lld questions. Pick what you can do consistently, and we'll work out your level (down to −, base, or +)."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%lld सवाल। जो आप लगातार कर पाते हैं वही चुनें, हम आपका लेवल निकाल देंगे (−, बेस या + तक)।"
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%lld pertanyaan. Pilih yang bisa kamu lakukan secara konsisten, dan kami hitung levelmu (sampai −, dasar, atau +)."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "全 %lld 問。安定してできるものを選ぶと、レベルを自動で判定します（−・標準・+ まで細分）"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%lld개 문항이에요. 꾸준히 할 수 있는 걸 고르면 레벨을 자동으로 계산해요(−, 기본, +까지 세분)."
          }
        },
        "ms" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%lld soalan. Pilih apa yang anda boleh buat secara konsisten, dan tahap anda dikira secara automatik (hingga −, asas atau +)."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%lld ข้อ เลือกตามที่คุณทำได้สม่ำเสมอ แล้วเราจะคำนวณระดับให้ (ละเอียดถึง −, ระดับหลัก หรือ +)"
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%lld câu hỏi. Chọn theo những gì bạn làm được ổn định, hệ thống sẽ tính trình độ của bạn (chi tiết đến −, mức chuẩn hoặc +)."
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%lld 道題，依你能穩定做到的選，自動算出你的等級（細分到 −、本級、+）"
          }
        }
      }
    },
