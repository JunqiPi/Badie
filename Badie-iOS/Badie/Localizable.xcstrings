    "人机验证没加载出来，请检查网络后重试。" : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "The security check didn’t load. Check your connection and try again."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "सिक्योरिटी चेक लोड नहीं हुआ। अपना कनेक्शन जाँचें और फिर से कोशिश करें।"
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pemeriksaan keamanan tidak termuat. Periksa koneksi lalu coba lagi."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "セキュリティチェックを読み込めませんでした。接続を確認してもう一度お試しください。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "보안 확인을 불러오지 못했어요. 연결을 확인하고 다시 시도해 주세요."
          }
        },
        "ms" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Semakan keselamatan tidak dimuatkan. Semak sambungan anda dan cuba lagi."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "โหลดการตรวจสอบความปลอดภัยไม่สำเร็จ ตรวจสอบการเชื่อมต่อแล้วลองอีกครั้ง"
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Không tải được bước kiểm tra bảo mật. Hãy kiểm tra kết nối rồi thử lại."
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "人機驗證沒有載入，請檢查網路後再試一次。"
          }
        }
      }
    },
