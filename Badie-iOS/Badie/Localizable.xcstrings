    "离开赛不到 30 分钟，来不及凑人了，换个时间试试" : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Less than 30 minutes to start, not enough time to find players. Try another time."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "शुरू होने में 30 मिनट से कम, खिलाड़ी खोजने का समय नहीं। कोई दूसरा समय आज़माएँ।"
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kurang dari 30 menit sebelum mulai, tidak cukup waktu mencari pemain. Coba waktu lain."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "開始まで 30 分を切っているため、メンバーを集められません。別の時間で試してください"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "시작까지 30분도 안 남아 인원을 모으기 어려워요. 다른 시간으로 시도해 보세요."
          }
        },
        "ms" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kurang 30 minit sebelum mula, tidak cukup masa untuk cari pemain. Cuba masa lain."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "เหลือไม่ถึง 30 นาทีก่อนเริ่ม หาคนไม่ทัน ลองเวลาอื่น"
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Còn chưa đến 30 phút là bắt đầu, không kịp tìm người. Hãy thử giờ khác."
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "離開賽不到 30 分鐘，來不及湊人了，換個時間試試"
          }
        }
      }
    },
