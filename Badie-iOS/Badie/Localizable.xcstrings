    "战术和技巧明显结合：用落点、节奏、假动作组织进攻，会随对手调整" : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Clearly combines tactics and skill: builds attacks with placement, tempo and deception, and adapts to opponents"
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "रणनीति और स्किल का साफ़ मेल: प्लेसमेंट, रफ़्तार और धोखे वाले शॉट से अटैक बनाते हैं, और विरोधी के हिसाब से बदलते हैं"
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Jelas memadukan taktik dan teknik: membangun serangan dengan penempatan, tempo, dan tipuan, serta menyesuaikan dengan lawan"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "戦術と技術がはっきり結びつく：コース、リズム、フェイントで攻撃を組み立て、相手に合わせて変えられる"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "전술과 기술이 확실히 결합됨: 코스, 템포, 페인트로 공격을 만들고 상대에 맞춰 조정해요"
          }
        },
        "ms" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Jelas menggabungkan taktik dan kemahiran: membina serangan dengan penempatan, rentak dan tipuan, serta menyesuaikan diri dengan lawan"
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ผสานแท็กติกกับเทคนิคได้ชัดเจน: ใช้ตำแหน่งลูก จังหวะ และการหลอกล่อในการบุก และปรับตามคู่แข่ง"
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kết hợp rõ chiến thuật và kỹ thuật: tổ chức tấn công bằng điểm rơi, nhịp độ và động tác giả, biết điều chỉnh theo đối thủ"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "戰術和技巧明顯結合：用落點、節奏、假動作組織進攻，會隨對手調整"
          }
        }
      }
    },
    "战术和技巧结合：用假动作、变线组织连续进攻，随对手调整" : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Combines tactics and skill: builds sustained attacks with deception and direction changes, adapts to opponents"
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "रणनीति और स्किल का मेल: धोखे वाले शॉट और दिशा बदलकर लगातार अटैक बनाते हैं, विरोधी के हिसाब से बदलते हैं"
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Memadukan taktik dan teknik: membangun serangan beruntun dengan tipuan dan perubahan arah, menyesuaikan dengan lawan"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "戦術と技術が結びつく：フェイントやコース変更で連続攻撃を組み立て、相手に合わせて変えられる"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "전술과 기술을 결합: 페인트와 방향 전환으로 연속 공격을 만들고 상대에 맞춰 조정해요"
          }
        },
        "ms" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Menggabungkan taktik dan kemahiran: membina serangan berterusan dengan tipuan dan perubahan arah, menyesuaikan diri dengan lawan"
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ผสานแท็กติกกับเทคนิค: บุกต่อเนื่องด้วยการหลอกล่อและเปลี่ยนทิศลูก ปรับตามคู่แข่ง"
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kết hợp chiến thuật và kỹ thuật: tấn công liên tục bằng động tác giả và đổi hướng, điều chỉnh theo đối thủ"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "戰術和技巧結合：用假動作、變線組織連續進攻，隨對手調整"
          }
        }
      }
    },
    "战术开始明显，会用落点和节奏调动对手" : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tactics are emerging: uses placement and tempo to move opponents around"
