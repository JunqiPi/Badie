    "机会好的时候偶尔能把力量打透，开始有角度、有威胁" : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "With a good chance, sometimes hits through with power and angle; starting to threaten"
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "अच्छा मौक़ा मिलने पर कभी-कभी पूरी ताक़त और एंगल से स्मैश; खतरा बनने लगे हैं"
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Saat dapat peluang bagus, kadang bisa smash bertenaga dan bersudut; mulai mengancam"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "チャンスボールなら時々しっかり力を乗せられ、角度もついて威力が出てきた"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "좋은 기회에서는 가끔 힘을 제대로 실어 각도 있게 쳐서 위협이 되기 시작해요"
          }
        },
        "ms" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Apabila peluang baik, kadangkala boleh smash berkuasa dan bersudut; mula berbahaya"
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ถ้าได้จังหวะดี บางครั้งตบได้หนักและมีมุม เริ่มอันตราย"
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Khi có cơ hội tốt, thỉnh thoảng đập được mạnh và có góc; bắt đầu có uy hiếp"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "機會好的時候偶爾能把力量打透，開始有角度、有威脅"
          }
        }
      }
    },
    "杀、吊、网前、防守没有明显短板" : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "No obvious weakness in smashes, drops, net play or defense"
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "स्मैश, ड्रॉप, नेट प्ले या डिफ़ेंस में कोई साफ़ कमज़ोरी नहीं"
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tidak ada kelemahan jelas dalam smash, dropshot, netting, atau bertahan"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "スマッシュ、ドロップ、ネット前、守備に目立った弱点がない"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "스매시, 드롭, 네트 플레이, 수비에 뚜렷한 약점이 없어요"
          }
        },
        "ms" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tiada kelemahan ketara dalam smash, dropshot, permainan jaring atau pertahanan"
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ตบ หยอด หน้าเน็ต และการรับ ไม่มีจุดอ่อนชัดเจน"
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Đập cầu, bỏ nhỏ, đánh lưới, phòng thủ không có điểm yếu rõ ràng"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "殺、吊、網前、防守沒有明顯短板"
          }
        }
      }
    },
    "杀球多半下网、出界" : {
      "localizations" : {
