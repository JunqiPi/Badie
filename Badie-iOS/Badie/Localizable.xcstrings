          "stringUnit" : {
            "state" : "translated",
            "value" : "この端末のすべてのアカウントとデータを消去し、初回起動時の状態に戻します。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "이 기기의 모든 계정과 데이터가 삭제되고 처음 설치한 상태로 돌아가요."
          }
        },
        "ms" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ini akan memadam semua akaun dan data pada peranti ini dan menetapkan semula aplikasi seperti baru dipasang."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "จะล้างบัญชีและข้อมูลทั้งหมดในเครื่องนี้ แล้วกลับไปเหมือนเปิดแอปครั้งแรก"
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Thao tác này xóa mọi tài khoản và dữ liệu trên thiết bị, đưa ứng dụng về như mới cài."
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "會清除本機所有帳號和資料，回到初次開啟的狀態。"
          }
        }
      }
    },
    "会用假动作和节奏变化组织进攻" : {
