    "发接发、移动补位、封网有基本意识" : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Basic awareness of serve and return, covering for your partner, and net coverage"
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "सर्व और रिटर्न, पार्टनर की जगह कवर करने और नेट कवरेज की बुनियादी समझ"
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Paham dasar servis dan pengembalian, menutup posisi partner, dan menjaga net"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "サービスとレシーブ、カバーの動き、前衛でのネットカバーについて基本的な意識がある"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "서브·리시브, 커버 이동, 네트 커버에 대한 기본 개념이 있음"
          }
        },
        "ms" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kesedaran asas tentang servis dan terima servis, mengisi ruang pasangan dan mengawal net"
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "มีความเข้าใจพื้นฐานเรื่องเสิร์ฟและรับเสิร์ฟ การขยับเติมตำแหน่ง และการคุมหน้าเน็ต"
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Có ý thức cơ bản về giao và đỡ giao cầu, di chuyển bọc lót cho đồng đội và chặn lưới"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "發接發、移動補位、封網有基本意識"
          }
        }
      }
    },
