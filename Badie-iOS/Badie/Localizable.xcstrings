    "底线到底线轻松，反手劈吊熟练，机会好时反手杀有威力" : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Baseline to baseline with ease, comfortable with backhand sliced drops, and a dangerous backhand smash when the chance comes"
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "बेसलाइन से बेसलाइन आसानी से, बैकहैंड स्लाइस्ड ड्रॉप में सहज, और मौका मिलने पर खतरनाक बैकहैंड स्मैश"
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dari baseline ke baseline dengan mudah, lancar sliced drop backhand, dan smash backhand berbahaya saat ada peluang"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ベースラインからベースラインまで楽に届き、バックハンドのカットも得意。チャンスではバックハンドスマッシュにも威力がある"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "베이스라인에서 베이스라인까지 수월하고, 백핸드 커트가 능숙하며 기회가 오면 백핸드 스매시도 위력적"
          }
        },
        "ms" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Garisan belakang ke garisan belakang dengan mudah, mahir sliced drop backhand, dan smash backhand berbahaya apabila ada peluang"
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "จากเส้นหลังถึงเส้นหลังได้สบาย ตัดหยอดแบ็คแฮนด์คล่อง และตบแบ็คแฮนด์ได้มีพลังเมื่อมีโอกาส"
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Từ cuối sân đến cuối sân dễ dàng, thành thạo cắt cầu trái tay, đập trái tay có uy lực khi có cơ hội"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "底線到底線輕鬆，反手劈吊熟練，機會好時反手殺球有威力"
          }
        }
      }
    },
