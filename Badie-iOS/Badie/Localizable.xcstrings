          }
        },
        "ms" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sangat tinggi bagi amatur, tetapi masih lebih banyak silap berbanding pemain profesional"
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "สูงมากสำหรับมือสมัครเล่น แต่ยังเสียมากกว่ามืออาชีพ"
