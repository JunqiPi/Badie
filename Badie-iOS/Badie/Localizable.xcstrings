    "羽毛球搭子？\n就在*今日*。" : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Badminton buddy?\nFind one *today*."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "बैडमिंटन पार्टनर?\n*आज* ही मिलेगा।"
          }
        },
        "id" : {
