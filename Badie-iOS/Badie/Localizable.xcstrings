          "stringUnit" : {
            "state" : "translated",
            "value" : "आपका %@ बैज अब दिख रहा है। अब से आपके लेवल में खिलाड़ियों के रिव्यू भी जुड़ेंगे, पर यह आपके वेरिफ़ाइड लेवल से ऊपर नहीं जाएगा।"
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Lencana %@ sekarang tampil. Mulai sekarang levelmu juga memperhitungkan ulasan pemain, tapi tidak akan melebihi tingkat verifikasimu."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ バッジが表示されるようになりました。今後のレベルにはプレイヤー評価も反映されますが、認証済みレベルを超えることはありません。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ 배지가 표시돼요. 앞으로 레벨에 플레이어 평가도 반영되지만 인증 등급을 넘지는 않아요."
          }
        },
        "ms" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Lencana %@ anda kini dipaparkan. Mulai sekarang tahap anda juga mengambil kira ulasan pemain, tetapi tidak akan melebihi peringkat yang disahkan."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "แสดงตรา %@ แล้ว ต่อจากนี้ระดับของคุณจะรวมรีวิวจากผู้เล่นด้วย แต่จะไม่เกินระดับที่ยืนยันแล้ว"
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Huy hiệu %@ của bạn đã hiển thị. Từ giờ trình độ của bạn sẽ tính cả đánh giá của người chơi, nhưng không vượt quá mức đã xác minh."
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "已顯示%@徽章。之後的等級會結合球友評價，但不會超過認證檔位。"
          }
        }
      }
    },
