          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "จะแสดงด้านล่างเมื่อทุกคนยืนยันแล้ว"
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
