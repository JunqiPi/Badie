    "挑球能到底线，正反手搓球正确，勾对角常用但质量一般" : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Lifts reach the baseline, correct forehand and backhand net spins, uses cross-court net shots often but quality is average"
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "लिफ़्ट बेसलाइन तक पहुँचती है, फ़ोरहैंड और बैकहैंड नेट स्पिन सही, क्रॉस-कोर्ट नेट शॉट अक्सर पर क्वालिटी औसत"
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Lob sampai baseline, netting spin forehand dan backhand sudah benar, sering pakai netting silang tapi kualitasnya biasa"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ロブはエンドラインまで届き、フォア・バックのヘアピンも正しい。クロスネットはよく使うが質は普通"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "리프트가 베이스라인까지 가고, 포핸드·백핸드 헤어핀이 정확하며, 크로스 헤어핀을 자주 쓰지만 질은 보통이에요"
          }
        },
        "ms" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Lob sampai ke garisan belakang, netting forehand dan backhand betul, kerap guna pukulan silang di jaring tetapi kualiti sederhana"
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ลูกงัดถึงท้ายคอร์ท ปั่นหน้าเน็ตโฟร์แฮนด์และแบ็คแฮนด์ถูกต้อง ใช้ลูกทแยงหน้าเน็ตบ่อยแต่คุณภาพปานกลาง"
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Lốp cầu tới cuối sân, vê cầu thuận tay và trái tay đúng, hay đánh chéo lưới nhưng chất lượng trung bình"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "挑球能到底線，正反手搓球正確，勾對角常用但品質一般"
          }
        }
      }
    },
    "挥拍对了，但发力、时机、击球点还不对，多靠挥手臂" : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Swing is right, but power, timing and contact point are off; mostly uses the arm"
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "स्विंग सही है, पर पावर, टाइमिंग और कॉन्टैक्ट पॉइंट गलत; ज़्यादातर बाँह से मारते हैं"
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ayunan sudah benar, tapi tenaga, timing, dan titik pukul masih belum pas; masih banyak mengandalkan lengan"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "スイングは正しいが、力の入れ方・タイミング・打点がまだ合わず、腕に頼りがち"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "스윙 동작은 맞지만 힘 전달, 타이밍, 타점이 아직 부정확하고 주로 팔로 쳐요"
          }
        },
        "ms" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hayunan betul, tetapi kuasa, masa dan titik pukulan belum tepat; banyak bergantung pada lengan"
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "วงสวิงถูกแล้ว แต่การส่งแรง จังหวะ และจุดปะทะยังไม่ถูก ส่วนใหญ่ใช้แต่แขน"
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vung vợt đúng nhưng lực, thời điểm và điểm chạm cầu chưa đúng; chủ yếu dùng cánh tay"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "揮拍對了，但發力、時機、擊球點還不對，多靠揮手臂"
          }
        }
      }
    },
