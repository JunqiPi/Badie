    "基本不会，只能绕头打或者放弃" : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Barely; can only hit round-the-head or gives up"
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "मुश्किल से; सिर्फ़ राउंड-द-हेड खेल पाते हैं या छोड़ देते हैं"
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hampir tidak bisa; hanya bisa round-the-head atau menyerah"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ほぼできず、ラウンド・ザ・ヘッドで打つかあきらめるしかない"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "거의 못 함, 라운드 더 헤드로만 치거나 포기"
          }
        },
        "ms" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hampir tidak; hanya boleh pukul round-the-head atau biarkan sahaja"
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "แทบไม่ได้ ได้แค่ตีอ้อมศีรษะหรือปล่อยลูก"
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Gần như không; chỉ đánh vòng qua đầu hoặc bỏ cầu"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "基本不會，只能繞頭打或者放棄"
          }
        }
      }
    },
