          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "อีกฝ่ายรับได้ภายใน 48 ชั่วโมง ถ้าไม่ตอบจะหมดอายุอัตโนมัติ ถ้าถูกปฏิเสธก็จะแสดงแค่ “ไม่ได้เกิดขึ้น” เมื่อรับแล้วจะสร้างเกมเดี่ยว 1 เกม และนับในอันดับเมื่อทั้งสองฝ่ายยืนยันผล"
          }
        },
        "vi" : {
