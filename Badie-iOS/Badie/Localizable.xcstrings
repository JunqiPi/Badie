        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "증빙으로 입증 가능한 가장 높은 단계를 선택하세요. 심사 중 낮아질 수 있어요."
          }
        },
        "ms" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pilih peringkat tertinggi yang disokong bukti anda. Ia mungkin diturunkan semasa semakan."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "เลือกระดับสูงสุดที่หลักฐานยืนยันได้ อาจถูกปรับลงระหว่างตรวจสอบ"
