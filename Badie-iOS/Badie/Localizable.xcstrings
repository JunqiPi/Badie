    "关闭后只有球友能私信你；球局群聊不受影响" : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "When off, only friends can message you. Game chats aren't affected"
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "बंद होने पर सिर्फ़ दोस्त आपको मैसेज कर सकेंगे। गेम चैट पर असर नहीं पड़ेगा"
          }
        },
        "id" : {
          "stringUnit" : {
