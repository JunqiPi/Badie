    "所有人确认后会出现在下面" : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Shows up below once everyone confirms"
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "सबके कन्फ़र्म करने पर यहाँ दिखेगा"
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Akan muncul di bawah setelah semua konfirmasi"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "全員が確認するとここに表示されます"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "모두 확인하면 아래에 표시돼요"
          }
        },
        "ms" : {
          "stringUnit" : {
            "state" : "translated",
