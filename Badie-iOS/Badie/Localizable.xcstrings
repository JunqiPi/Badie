    "快速匹配一个搭子，或者发起球局招募附近球友。" : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Quickly match with a buddy, or start a game and invite nearby players."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "क्विक मैच से पार्टनर ढूँढें, या गेम शुरू करके आसपास के खिलाड़ियों को बुलाएँ।"
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cari teman main lewat Quick Match, atau mulai game dan ajak pemain sekitar."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "クイックマッチで仲間を見つけるか、ゲームを作成して近くのプレイヤーを募集しましょう。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "빠른 매칭으로 버디를 찾거나, 게임을 만들어 근처 플레이어를 모아 보세요."
          }
        },
        "ms" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cari rakan main dengan Padanan Pantas, atau mulakan permainan dan jemput pemain berdekatan."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "หาบัดดี้ด้วยแมตช์ด่วน หรือสร้างเกมแล้วชวนผู้เล่นใกล้ๆ"
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ghép nhanh với một bạn đánh, hoặc tạo trận và mời người chơi gần bạn."
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "快速配對一個搭子，或者發起球局招募附近球友。"
          }
        }
      }
    },
    "快速匹配会优先使用最近的常用时间。最多保存 %lld 个，还可添加 %lld 个。" : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Quick Match tries your nearest usual time first. You can save up to %lld (%lld left)."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "क्विक मैच पहले आपका सबसे नज़दीकी नियमित समय आज़माता है। आप %lld तक सेव कर सकते हैं (%lld बाकी)।"
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Quick Match mencoba waktu rutin terdekatmu dulu. Kamu bisa menyimpan hingga %lld (sisa %lld)."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "クイックマッチは直近のよく使う時間を優先します。最大 %lld 件まで保存でき、あと %lld 件追加できます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "빠른 매칭은 가장 가까운 자주 쓰는 시간을 먼저 사용해요. 최대 %lld개까지 저장할 수 있고, %lld개 더 추가할 수 있어요."
          }
        },
        "ms" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Padanan Pantas mencuba masa biasa anda yang paling hampir dahulu. Anda boleh simpan hingga %lld (tinggal %lld)."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "แมตช์ด่วนจะใช้เวลาประจำที่ใกล้ที่สุดก่อน บันทึกได้สูงสุด %lld รายการ (เพิ่มได้อีก %lld)"
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ghép nhanh ưu tiên khung giờ quen thuộc gần nhất. Bạn có thể lưu tối đa %lld (còn %lld)."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "快速匹配会优先使用最近的常用时间。最多保存 %1$lld 个，还可添加 %2$lld 个。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "快速配對會優先使用最近的常用時間。最多儲存 %lld 個，還可新增 %lld 個。"
          }
        }
      }
    },
