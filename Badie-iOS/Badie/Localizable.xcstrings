    "已候补第 %lld 位，有人退出会自动递补并通知你" : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "You're #%lld on the waitlist. If someone drops out, you'll be moved in and notified"
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "आप वेटलिस्ट में #%lld हैं। कोई हटे तो आपको अंदर लेकर सूचना दी जाएगी"
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kamu #%lld di daftar tunggu. Kalau ada yang mundur, kamu otomatis masuk dan diberi tahu"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "キャンセル待ち %lld 番目です。キャンセルが出たら自動で繰り上げ、お知らせします"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "대기 %lld번이에요. 빠지는 사람이 생기면 자동 충원되고 알려 드려요"
          }
        },
        "ms" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Anda #%lld dalam senarai menunggu. Jika ada yang menarik diri, anda akan dimasukkan dan dimaklumkan"
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "คุณอยู่ลำดับที่ %lld ในรายชื่อสำรอง ถ้ามีคนถอนตัวจะเลื่อนขึ้นอัตโนมัติและแจ้งให้ทราบ"
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bạn đứng thứ %lld trong danh sách chờ. Nếu có người rút, bạn sẽ được vào và nhận thông báo"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "已候補第 %lld 位，有人退出會自動遞補並通知你"
          }
        }
      }
    },
