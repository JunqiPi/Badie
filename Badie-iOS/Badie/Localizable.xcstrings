    "被动球、极限球有时能过渡出来：回到对方后场或网前，让自己回位" : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sometimes recovers from defensive and stretched shots: returns to the opponent's back court or net to get back in position"
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "डिफ़ेंसिव और खिंचे हुए शॉट से कभी-कभी संभल जाते हैं: विरोधी के बैक कोर्ट या नेट पर लौटाकर अपनी पोज़िशन में आ जाते हैं"
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kadang bisa keluar dari bola tertekan dan bola jauh: mengembalikan ke belakang atau depan net lawan untuk kembali ke posisi"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "苦しい球や厳しい球を時々立て直せる：相手の奥かネット前に返して、自分のポジションに戻る"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "수비 상황이나 몸을 뻗어 받는 공도 가끔 넘겨요: 상대 후위나 네트 앞으로 보내 자리로 돌아와요"
          }
        },
        "ms" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kadang-kadang dapat pulih daripada bola tertekan dan bola jauh: membalas ke gelanggang belakang atau jaring lawan untuk kembali ke posisi"
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "บางครั้งแก้ลูกตั้งรับและลูกสุดตัวได้: ส่งกลับไปท้ายคอร์ทหรือหน้าเน็ตฝั่งคู่แข่งเพื่อกลับเข้าตำแหน่ง"
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Đôi khi gỡ được cầu bị động và cầu khó: trả về cuối sân hoặc lưới đối phương để kịp về vị trí"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "被動球、極限球有時能過渡出來：回到對方後場或網前，讓自己回位"
          }
        }
      }
    },
    "被动球、极限球有机会摆脱：被压到底线、调到死角也能过渡出来" : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Can escape defensive and stretched shots: recovers even when pushed to the baseline or into corners"
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "डिफ़ेंसिव और खिंचे हुए शॉट से निकल सकते हैं: बेसलाइन या कोनों में धकेले जाने पर भी संभल जाते हैं"
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bisa lolos dari bola tertekan dan bola jauh: tetap bisa keluar meski terdesak ke baseline atau sudut"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "苦しい球や厳しい球から抜け出せる：エンドラインや隅に追い込まれても立て直せる"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "수비 상황이나 몸을 뻗어 받는 공에서 벗어날 수 있어요: 베이스라인이나 구석으로 몰려도 넘겨요"
          }
        },
        "ms" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Boleh lepas daripada bola tertekan dan bola jauh: tetap pulih walaupun ditolak ke garisan belakang atau ke sudut"
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "มีโอกาสหลุดจากลูกตั้งรับและลูกสุดตัว: แม้ถูกกดไปเส้นหลังหรือมุมสนามก็แก้เกมได้"
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Có thể thoát cầu bị động và cầu khó: bị ép về cuối sân hay điều vào góc chết vẫn gỡ được"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "被動球、極限球有機會擺脫：被壓到底線、調到死角也能過渡出來"
          }
        }
      }
    },
    "被动球多数能摆脱；技术特点和战术开始明显（有自己的得分手段，会用落点和节奏调动对手）" : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Escapes most defensive shots; style and tactics are emerging (has their own ways to win points, moves opponents with placement and tempo)"
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ज़्यादातर डिफ़ेंसिव शॉट से निकल जाते हैं; स्टाइल और रणनीति उभर रही है (पॉइंट जीतने के अपने तरीके हैं, प्लेसमेंट और रफ़्तार से विरोधी को दौड़ाते हैं)"
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Lolos dari sebagian besar bola tertekan; gaya main dan taktik mulai terlihat (punya cara sendiri mencetak poin, menggerakkan lawan dengan penempatan dan tempo)"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "苦しい球はほぼ立て直せる。技術の特徴と戦術が見え始める（自分なりの得点パターンがあり、コースとリズムで相手を動かせる）"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "수비 상황 대부분에서 벗어나고, 스타일과 전술이 보이기 시작해요 (자신만의 득점 방법이 있고 코스와 템포로 상대를 움직여요)"
          }
        },
        "ms" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dapat lepas daripada kebanyakan bola tertekan; gaya dan taktik mula kelihatan (ada cara sendiri untuk mendapat mata, menggerakkan lawan dengan penempatan dan rentak)"
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "หลุดจากลูกตั้งรับได้เกือบทุกครั้ง เริ่มมีสไตล์และแท็กติกชัดเจน (มีวิธีทำแต้มของตัวเอง ใช้ตำแหน่งลูกและจังหวะดึงคู่แข่ง)"
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Thoát được phần lớn cầu bị động; bắt đầu có lối chơi và chiến thuật riêng (có cách ghi điểm của mình, dùng điểm rơi và nhịp độ để điều đối thủ)"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "被動球多數能擺脫；技術特點和戰術開始明顯（有自己的得分手段，會用落點和節奏調動對手）"
          }
        }
      }
    },
