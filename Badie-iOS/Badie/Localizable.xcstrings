    "移动地图，让图钉对准球馆入口（工业区、学校里的场馆尤其要对准）" : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Move the map so the pin is on the venue entrance (especially for venues in industrial parks or schools)"
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "मैप हिलाएँ ताकि पिन वेन्यू के एंट्रेंस पर हो (खासकर इंडस्ट्रियल एरिया या स्कूलों के अंदर वाले वेन्यू के लिए)"
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Geser peta agar pin tepat di pintu masuk GOR (terutama untuk GOR di kawasan industri atau sekolah)"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "地図を動かしてピンを会場の入口に合わせてください（工業団地や学校内の会場は特に）"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "지도를 움직여 핀을 체육관 입구에 맞춰 주세요 (산업단지나 학교 안의 체육관은 특히 정확히)"
          }
        },
        "ms" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Gerakkan peta supaya pin berada di pintu masuk gelanggang (terutamanya gelanggang di kawasan perindustrian atau sekolah)"
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "เลื่อนแผนที่ให้หมุดตรงกับทางเข้าสนาม (โดยเฉพาะสนามในนิคมอุตสาหกรรมหรือในโรงเรียน)"
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Di chuyển bản đồ để ghim nằm đúng lối vào sân (nhất là sân trong khu công nghiệp hoặc trường học)"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "移動地圖，讓圖釘對準球館入口（工業區、學校裡的場館尤其要對準）"
          }
        }
      }
    },
