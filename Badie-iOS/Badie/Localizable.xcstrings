    "按证据能证明的最高一档填，审核时可能下调" : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Choose the highest tier your evidence supports. It may be lowered during review."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "आपके सबूत से जो सबसे ऊँचा स्तर साबित हो, वही चुनें। समीक्षा में इसे घटाया जा सकता है।"
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pilih tingkat tertinggi yang didukung buktimu. Bisa diturunkan saat peninjauan."
