    "和吊球、杀球动作一致，对手判断不出你打什么" : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Same motion as your drops and smashes, so opponents can't read you"
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ड्रॉप और स्मैश जैसा ही एक्शन, ताकि सामने वाला भाँप न सके"
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Gerakannya sama dengan dropshot dan smash-mu, jadi lawan tidak bisa membacanya"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ドロップやスマッシュと同じフォームで、相手に読まれない"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "드롭·스매시와 동작이 같아 상대가 무엇을 칠지 읽지 못함"
          }
        },
        "ms" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Gaya sama seperti dropshot dan smash anda, jadi lawan tidak dapat membaca anda"
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
