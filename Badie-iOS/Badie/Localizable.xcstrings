    "全场多点步法轻松，启动和移动速度中上" : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Moves easily to every spot on court; above-average first step and speed"
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "कोर्ट के हर कोने तक आसानी से पहुँचते हैं; पहला कदम और रफ़्तार औसत से बेहतर"
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bergerak mudah ke semua titik lapangan; langkah awal dan kecepatan di atas rata-rata"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "コートのどこへも楽に動け、初動と移動の速さは平均以上"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "코트 전역 풋워크가 수월하고 스타트와 이동 속도가 중상 수준"
          }
        },
        "ms" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bergerak dengan mudah ke setiap sudut gelanggang; langkah pertama dan kelajuan atas purata"
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "เคลื่อนที่ทั่วคอร์ทได้สบาย ออกตัวและความเร็วสูงกว่าค่าเฉลี่ย"
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Di chuyển dễ dàng đến mọi điểm trên sân; khởi động và tốc độ trên trung bình"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "全場多點步法輕鬆，啟動和移動速度中上"
          }
        }
      }
    },
    "全场步法正确并能用在打球中，但启动和移动速度不够" : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Correct footwork all over the court and uses it in play, but not fast enough off the mark"
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "पूरे कोर्ट पर सही फुटवर्क और खेल में इस्तेमाल भी, पर शुरुआत में तेज़ी कम"
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Footwork benar di seluruh lapangan dan dipakai saat main, tapi langkah awalnya kurang cepat"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "コート全体で正しいフットワークができ、プレー中にも使えるが、初動と移動の速さが足りない"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "코트 전역 풋워크가 정확하고 실전에서도 쓰지만 스타트와 이동 속도가 부족함"
          }
        },
        "ms" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Footwork betul di seluruh gelanggang dan digunakan semasa bermain, tetapi kurang pantas bermula"
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ฟุตเวิร์คถูกต้องทั่วคอร์ทและใช้ได้จริงตอนเล่น แต่ออกตัวและเคลื่อนที่ยังไม่เร็วพอ"
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bộ chân đúng trên toàn sân và áp dụng được khi chơi, nhưng khởi động chưa đủ nhanh"
