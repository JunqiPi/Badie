    "%@ 是问卷能给的最高档；球友评价最多推到 %@，7 起凭证据认证。" : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ is the highest the survey can give. Player reviews can take you up to %@; 7 and up requires proof."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ असेसमेंट से मिलने वाला सबसे ऊँचा लेवल है। खिलाड़ियों के रिव्यू आपको %@ तक ले जा सकते हैं; 7 और उससे ऊपर के लिए सबूत चाहिए।"
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ adalah level tertinggi dari kuesioner. Ulasan pemain bisa menaikkanmu sampai %@; level 7 ke atas butuh bukti."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ はレベル判定で出せる最高レベルです。プレイヤー評価では %@ まで上がり、7 以上は証明による認証が必要です。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@은(는) 테스트로 받을 수 있는 가장 높은 단계예요. 플레이어 평가로는 %@까지 올라갈 수 있고, 7부터는 증빙으로 인증해요."
          }
        },
        "ms" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ ialah tahap tertinggi yang boleh diberi oleh soal selidik. Ulasan pemain boleh menaikkan anda hingga %@; tahap 7 ke atas memerlukan bukti."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ คือระดับสูงสุดที่แบบทดสอบให้ได้ รีวิวจากผู้เล่นดันได้สูงสุดถึง %@ ส่วนระดับ 7 ขึ้นไปต้องยืนยันด้วยหลักฐาน"
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ là mức cao nhất bảng câu hỏi có thể cho. Đánh giá của người chơi có thể đưa bạn lên tối đa %@; từ 7 trở lên cần bằng chứng để xác minh."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "%1$@ 是问卷能给的最高档；球友评价最多推到 %2$@，7 起凭证据认证。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ 是問卷能給的最高檔；球友評價最多推到 %@，7 以上需憑證據認證。"
          }
        }
      }
    },
    "%@ 有人退出，你已自动报上。去不了记得提前取消。" : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@: someone dropped out, so you're in. If you can't make it, cancel early."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@: किसी ने नाम वापस लिया, इसलिए आप शामिल हो गए। न आ सकें तो पहले ही कैंसिल कर दें।"
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@: ada yang mundur, jadi kamu otomatis masuk. Kalau tidak bisa datang, batalkan lebih awal."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@：キャンセルが出たため、自動で参加が確定しました。行けなくなったら早めにキャンセルしてください。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@: 빠진 사람이 있어 자동으로 참가됐어요. 못 가게 되면 미리 취소해 주세요."
          }
        },
        "ms" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@: seseorang menarik diri, jadi anda kini didaftarkan. Jika tidak dapat hadir, batalkan awal."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@: มีคนถอนตัว คุณได้เข้าร่วมอัตโนมัติ ถ้าไปไม่ได้อย่าลืมยกเลิกล่วงหน้า"
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@: có người rút nên bạn đã được tự động thêm vào. Nếu không đi được, hãy hủy sớm."
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ 有人退出，你已自動報上。去不了記得提前取消。"
          }
        }
      }
    },
    "%@ 由组织者取消，不影响你的记录。" : {
