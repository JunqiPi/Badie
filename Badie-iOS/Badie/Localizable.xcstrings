          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "이메일 주소가 올바르지 않은 것 같아요."
          }
        },
        "ms" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Alamat e-mel itu nampaknya tidak betul."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ที่อยู่อีเมลนี้ดูไม่ถูกต้อง"
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
