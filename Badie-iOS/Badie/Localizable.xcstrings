    "前臂内外旋和手腕发力熟练，开始体会手指发力" : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Comfortable using forearm rotation and wrist; starting to use finger power"
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "फ़ोरआर्म रोटेशन और कलाई का इस्तेमाल सहज; उंगलियों की ताकत का इस्तेमाल शुरू"
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Lancar memakai putaran lengan bawah dan pergelangan; mulai memakai tenaga jari"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "前腕の回内・回外と手首の力の使い方に慣れ、指の力の使い方をつかみ始めている"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "전완 회내·회외와 손목 힘 쓰기가 능숙하고, 손가락 힘을 쓰는 감을 잡기 시작함"
          }
        },
        "ms" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mahir guna putaran lengan bawah dan pergelangan tangan; mula guna kuasa jari"
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ใช้การหมุนแขนท่อนล่างและข้อมือได้คล่อง เริ่มใช้แรงนิ้ว"
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Thành thạo xoay cẳng tay và dùng lực cổ tay; bắt đầu cảm nhận lực ngón tay"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "前臂內外旋和手腕發力熟練，開始體會手指發力"
          }
        }
      }
    },
