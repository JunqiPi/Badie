          "stringUnit" : {
            "state" : "translated",
            "value" : "स्ट्रेट और क्रॉस-कोर्ट अटैक सही, पावर और रफ़्तार औसत से ऊपर; कुछ हद तक खतरनाक"
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Serangan lurus dan silang dengan teknik benar, tenaga dan kecepatan di atas rata-rata; cukup mengancam"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ストレート・クロスの攻撃フォームが正しく、パワーとスピードは中の上で、ある程度脅威になる"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "스트레이트·크로스 공격이 정확하고 힘과 속도가 평균 이상이라 어느 정도 위협적이에요"
          }
        },
        "ms" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Serangan lurus dan silang yang betul dengan kuasa dan kelajuan atas purata; agak berbahaya"
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "บุกตรงและทแยงได้ถูกหลัก พลังและความเร็วค่อนข้างดี มีความอันตรายพอสมควร"
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tấn công thẳng và chéo đúng kỹ thuật, lực và tốc độ khá, có độ uy hiếp nhất định"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "直線、斜線進攻規範，力量速度中上，有一定威脅"
          }
        }
      }
    },
