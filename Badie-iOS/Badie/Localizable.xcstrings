    "搓、勾、推、扑都熟练并用在实战里" : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Fluent net spins, cross-court net shots, pushes and net kills in real games"
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "नेट स्पिन, क्रॉस-कोर्ट नेट शॉट, पुश और नेट किल में माहिर, असली गेम में भी"
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Lancar netting spin, netting silang, push, dan net kill saat main sungguhan"
