        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Biết cách đánh cầu xuống nhưng chưa truyền được lực vào cầu"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "知道怎麼往下壓，但力量打不透"
          }
        }
      }
    },
    "知道要把球打到对方难接的地方，但多数时候还做不到" : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Knows to hit where it's hard to return, but usually can't yet"
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "जानते हैं कि ऐसी जगह मारना है जहाँ लौटाना मुश्किल हो, पर अक्सर कर नहीं पाते"
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tahu harus memukul ke tempat yang sulit dikembalikan, tapi biasanya belum bisa"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "相手が取りにくい所に打つべきとわかっているが、まだたいていできない"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "상대가 받기 어려운 곳으로 쳐야 한다는 건 알지만 대부분은 아직 못 해요"
          }
        },
        "ms" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tahu perlu pukul ke tempat yang sukar dibalas, tetapi selalunya belum mampu"
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "รู้ว่าต้องตีไปจุดที่รับยาก แต่ส่วนใหญ่ยังทำไม่ได้"
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Biết phải đánh vào chỗ khó đỡ nhưng phần lớn chưa làm được"
