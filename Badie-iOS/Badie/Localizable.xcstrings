    "匹配、确认和取消的消息也会发到你的登录邮箱" : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Match offers, confirmations and cancellations also go to the email you sign in with."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "मैच, कन्फ़र्मेशन और कैंसिल होने की सूचना उस ईमेल पर भी भेजी जाएगी जिससे आप साइन इन करते हैं।"
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tawaran match, konfirmasi, dan pembatalan juga dikirim ke email yang kamu pakai untuk masuk."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "マッチ、確定、キャンセルのお知らせを、ログインに使っているメールアドレスにも送ります。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "매칭, 확정, 취소 소식을 로그인한 이메일로도 보내요."
          }
        },
        "ms" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tawaran padanan, pengesahan dan pembatalan juga dihantar ke e-mel yang anda guna untuk log masuk."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ข่าวการจับคู่ การยืนยัน และการยกเลิกจะส่งไปที่อีเมลที่คุณใช้เข้าสู่ระบบด้วย"
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Thông báo ghép trận, xác nhận và hủy cũng được gửi tới email bạn dùng để đăng nhập."
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "配對、確認和取消的通知也會寄到你登入用的電子郵件。"
          }
        }
      }
    },
    "匹配成功或添加球友后，就可以在这里约时间、约球馆。" : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Once you're matched or add friends, you can set up times and venues here."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "मैच मिलने या दोस्त जोड़ने के बाद, आप यहाँ समय और वेन्यू तय कर सकते हैं।"
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Setelah dapat match atau menambah teman, kamu bisa atur waktu dan GOR di sini."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "マッチングが成立するか友達を追加すると、ここで時間や会場を決められます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "매칭되거나 친구를 추가하면 여기서 시간과 체육관을 정할 수 있어요."
          }
        },
        "ms" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sebaik anda dipadankan atau menambah rakan, anda boleh atur masa dan gelanggang di sini."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "เมื่อจับคู่สำเร็จหรือเพิ่มเพื่อนแล้ว คุณนัดเวลาและสนามได้ที่นี่"
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Khi đã ghép được hoặc kết bạn, bạn có thể hẹn giờ và sân ở đây."
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "配對成功或加了球友後，就可以在這裡約時間、約球館。"
          }
        }
      }
    },
