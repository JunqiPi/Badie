    "最晚%@前全部确认，否则自动取消，不计入任何记录" : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Everyone must confirm by %@, or it's canceled automatically. It won't go on anyone's record"
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "सभी को %@ तक कन्फ़र्म करना होगा, वरना यह अपने-आप कैंसिल हो जाएगा। किसी के रिकॉर्ड में नहीं जुड़ेगा"
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Semua harus konfirmasi sebelum %@, atau otomatis dibatalkan. Tidak masuk catatan siapa pun"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@までに全員が確定しないと自動でキャンセルされます。誰の記録にも残りません"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "늦어도 %@까지 모두 확인해야 하며, 안 그러면 자동 취소돼요. 어떤 기록에도 남지 않아요"
          }
        },
        "ms" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Semua orang mesti mengesahkan sebelum %@, atau ia dibatalkan secara automatik. Ia tidak masuk rekod sesiapa"
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ทุกคนต้องยืนยันก่อน %@ ไม่อย่างนั้นจะยกเลิกอัตโนมัติ และไม่ถูกบันทึกในประวัติของใคร"
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mọi người phải xác nhận trước %@, nếu không sẽ tự động hủy. Không bị ghi vào hồ sơ của ai"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "最晚%@前全部確認，否則自動取消，不計入任何紀錄"
          }
        }
      }
    },
    "最晚%@（开赛前 2 小时）前所有人都要确认。到点没约成会自动结束，不计入任何记录。" : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Everyone must confirm by %@ (2 hours before start). If not, it ends automatically and won't go on anyone's record."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "सभी को %@ (शुरू होने से 2 घंटे पहले) तक कन्फ़र्म करना होगा। नहीं तो यह अपने-आप खत्म हो जाएगा और किसी के रिकॉर्ड में नहीं जुड़ेगा।"
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Semua harus konfirmasi sebelum %@ (2 jam sebelum mulai). Kalau tidak, otomatis berakhir dan tidak masuk catatan siapa pun."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@（開始 2 時間前）までに全員の確定が必要です。成立しなければ自動で終了し、誰の記録にも残りません。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "늦어도 %@(시작 2시간 전)까지 모두 확인해야 해요. 시간 안에 성사되지 않으면 자동 종료되며 어떤 기록에도 남지 않아요."
          }
        },
        "ms" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Semua orang mesti mengesahkan sebelum %@ (2 jam sebelum mula). Jika tidak, ia tamat secara automatik dan tidak masuk rekod sesiapa."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ทุกคนต้องยืนยันก่อน %@ (2 ชั่วโมงก่อนเริ่ม) ถ้าถึงเวลาแล้วยังไม่สำเร็จ จะสิ้นสุดอัตโนมัติและไม่ถูกบันทึกในประวัติของใคร"
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mọi người phải xác nhận trước %@ (2 giờ trước giờ chơi). Nếu không, yêu cầu tự kết thúc và không bị ghi vào hồ sơ của ai."
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "最晚%@（開賽前 2 小時）前所有人都要確認。到時間沒約成會自動結束，不計入任何紀錄。"
          }
        }
      }
    },
    "最近 %lld 天和多位球友有赛果争议，暂不上榜，核实后恢复" : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Results disputed with several players in the last %lld days — off the leaderboards until reviewed"
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "पिछले %lld दिनों में कई खिलाड़ियों के साथ नतीजे पर विवाद रहा — जाँच पूरी होने तक लीडरबोर्ड पर नहीं दिखेंगे"
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hasil diperselisihkan dengan beberapa pemain dalam %lld hari terakhir — tidak tampil di papan peringkat sampai ditinjau"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "過去 %lld 日に複数の相手と結果の食い違いがあったため、確認が済むまでランキングに表示されません"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "최근 %lld일 동안 여러 플레이어와 결과 분쟁이 있어 확인될 때까지 순위표에 표시되지 않아요"
          }
        },
        "ms" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Keputusan dipertikaikan dengan beberapa pemain dalam %lld hari lepas, jadi anda tidak disenaraikan dalam papan pendahulu sehingga disemak"
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ใน %lld วันที่ผ่านมามีผลการแข่งไม่ตรงกันกับผู้เล่นหลายคน จึงยังไม่แสดงในอันดับจนกว่าจะตรวจสอบ"
