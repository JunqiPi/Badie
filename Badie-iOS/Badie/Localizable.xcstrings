    "%@ · %@。你会被优先安排，不计入任何记录。" : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ · %@. You'll get priority, and it won't go on your record."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ · %@। आपको प्राथमिकता मिलेगी, और यह आपके रिकॉर्ड में नहीं जुड़ेगा।"
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ · %@. Kamu akan diprioritaskan, dan ini tidak masuk catatanmu."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ · %@。優先的に案内され、記録には一切残りません。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ · %@. 우선 배정되며 어떤 기록에도 남지 않아요."
          }
        },
        "ms" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ · %@. Anda akan diutamakan dan ia tidak masuk rekod."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ · %@ คุณจะได้สิทธิ์ก่อน และไม่ถูกบันทึกในประวัติ"
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ · %@. Bạn sẽ được ưu tiên xếp, và không bị ghi vào hồ sơ."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
