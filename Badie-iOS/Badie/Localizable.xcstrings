    "高低各一档（1/3 级）；差得多就精确调，越如实越好" : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "One step up or down (1/3 level). If it's way off, fine-tune it. The more accurate, the better"
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "एक स्टेप ऊपर या नीचे (1/3 लेवल)। अगर काफ़ी अलग है, तो बारीकी से चुनें। जितना सटीक, उतना बेहतर"
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Satu tingkat naik atau turun (1/3 level). Kalau jauh berbeda, atur lebih detail. Makin akurat, makin baik"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "上下 1 段階ずつ（1/3 レベル）。大きくずれているなら細かく調整。正直なほど正確になります"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "위아래 한 단계씩(1/3 레벨)이에요. 차이가 크면 세부 조정하세요. 정확할수록 좋아요"
          }
        },
        "ms" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Satu peringkat naik atau turun (1/3 tahap). Jika jauh berbeza, perhalusi. Lebih tepat, lebih baik"
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "สูงหรือต่ำลงหนึ่งขั้น (1/3 ระดับ) ถ้าห่างมากให้ปรับละเอียด ยิ่งตรงความจริงยิ่งดี"
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Lên hoặc xuống một mức (1/3 cấp). Nếu lệch nhiều, hãy tinh chỉnh. Càng chính xác càng tốt"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "高低各一檔（1/3 級）；差得多就精確調整，越如實越好"
          }
        }
      }
    },
