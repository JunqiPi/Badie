        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "핀을 놓고 주소를 확인해야 다른 사람도 같은 장소를 찾을 수 있어요"
          }
        },
        "ms" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Letak pin dan semak alamat supaya orang lain dapat cari tempat yang sama"
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ปักหมุดและตรวจที่อยู่ให้ถูก เพื่อให้คนอื่นหาที่เดียวกันเจอ"
