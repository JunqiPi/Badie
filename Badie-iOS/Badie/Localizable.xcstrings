    "不被动时，能从己方中后场回到对方后场" : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "When not under pressure, returns from your mid–back court to their back court"
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "दबाव न हो तो अपने मिड–बैक कोर्ट से विरोधी के बैक कोर्ट तक लौटा देते हैं"
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Saat tidak tertekan, bisa mengembalikan dari tengah–belakang lapanganmu ke belakang lapangan lawan"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "余裕があれば、自陣の中盤〜後方から相手コートの奥まで返せる"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "압박받지 않을 때는 우리 중후위에서 상대 후위까지 보낼 수 있음"
          }
        },
        "ms" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Apabila tidak tertekan, boleh pulangkan dari tengah–belakang gelanggang sendiri ke belakang gelanggang lawan"
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ตอนไม่ถูกกดดัน ตีจากกลาง–ท้ายคอร์ทฝั่งเราไปถึงท้ายคอร์ทฝั่งตรงข้ามได้"
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Khi không bị ép, đánh từ giữa–cuối sân mình về được cuối sân đối phương"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "不被動時，能從己方中後場回到對方後場"
          }
        }
      }
    },
