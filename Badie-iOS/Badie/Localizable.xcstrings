    "正反手握拍基本正确，但转换不顺" : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Forehand and backhand grips are mostly correct, but switching isn't smooth"
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "फ़ोरहैंड और बैकहैंड ग्रिप ज़्यादातर सही, पर बदलना सहज नहीं"
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Grip forehand dan backhand sebagian besar benar, tapi peralihannya belum mulus"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "フォア・バックのグリップはほぼ正しいが、持ち替えがスムーズでない"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "포핸드·백핸드 그립은 대체로 맞지만 전환이 매끄럽지 않아요"
          }
        },
        "ms" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Genggaman forehand dan backhand kebanyakannya betul, tetapi pertukaran belum lancar"
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "จับไม้โฟร์แฮนด์และแบ็คแฮนด์ถูกต้องโดยพื้นฐาน แต่เปลี่ยนยังไม่คล่อง"
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cầm vợt thuận tay và trái tay cơ bản đúng, nhưng chuyển đổi chưa mượt"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "正反手握拍大致正確，但轉換不順"
          }
        }
      }
    },
    "正反手都会搓，勾对角常用但不够贴网" : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Net spins on both sides, uses cross-court net shots often but not tight enough"
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "दोनों तरफ़ नेट स्पिन, क्रॉस-कोर्ट नेट शॉट अक्सर पर नेट से पूरी तरह सटे नहीं"
