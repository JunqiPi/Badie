    "再打 %lld 场并获得评价后，等级将按“问卷 %lld%% + 球友评价 %lld%%”计算" : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "After %lld more games with reviews, your level will be “survey %lld%% + player reviews %lld%%”"
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "रिव्यू के साथ %lld और गेम के बाद, आपका लेवल “असेसमेंट %lld%% + खिलाड़ियों के रिव्यू %lld%%” से तय होगा"
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Setelah %lld game lagi dengan ulasan, levelmu dihitung dari “kuesioner %lld%% + ulasan pemain %lld%%”"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "評価付きであと %lld 試合プレーすると、レベルは「レベル判定 %lld%% + プレイヤー評価 %lld%%」で算出されます"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "평가를 받은 게임을 %lld번 더 치면 레벨이 ‘테스트 %lld%% + 플레이어 평가 %lld%%’로 계산돼요"
          }
        },
        "ms" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Selepas %lld lagi permainan dengan ulasan, tahap anda akan dikira sebagai “soal selidik %lld%% + ulasan pemain %lld%%”"
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "เมื่อเล่นอีก %lld เกมและได้รับรีวิว ระดับของคุณจะคิดจาก “แบบทดสอบ %lld%% + รีวิวจากผู้เล่น %lld%%”"
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sau %lld trận nữa có đánh giá, trình độ của bạn sẽ được tính theo “bảng câu hỏi %lld%% + đánh giá của người chơi %lld%%”"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "再打 %1$lld 场并获得评价后，等级将按“问卷 %2$lld%% + 球友评价 %3$lld%%”计算"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "再打 %lld 場並獲得評價後，等級將按「問卷 %lld%% + 球友評價 %lld%%」計算"
          }
        }
      }
    },
