        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ड्राइव में अच्छे और रफ़्तार बढ़ा सकते हैं"
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bagus di drive dan bisa mempercepat tempo"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ドライブが得意で、自分からスピードを上げられる"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "드라이브가 좋은 편이고 먼저 템포를 올릴 수 있음"
          }
        },
        "ms" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bagus dalam drive dan boleh mempercepatkan rali"
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ดาดหน้าดี และเร่งจังหวะได้"
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tạt cầu tốt và có thể chủ động tăng tốc"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "平抽擋比較好，能主動加速"
          }
        }
      }
    },
    "平高、高远、各种吊杀熟练，落点基本到位；反手直线斜线吊都会，后场回后场轻松" : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Comfortable with attacking clears, high clears, and all drops and smashes, with mostly good placement; backhand drops straight and cross-court, back-court to back-court comes easily"
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "अटैकिंग क्लियर, हाई क्लियर और हर तरह के ड्रॉप और स्मैश में सहज, प्लेसमेंट ज़्यादातर सही; बैकहैंड से सीधा और क्रॉस-कोर्ट ड्रॉप, बैक कोर्ट से बैक कोर्ट आसानी से"
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Lancar clear menyerang, clear tinggi, serta semua dropshot dan smash, penempatan umumnya bagus; dropshot backhand lurus dan silang, dari belakang ke belakang mudah"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ドリブンクリア、ハイクリア、各種ドロップとスマッシュが得意で、コースもほぼ狙いどおり。バックハンドでストレート・クロスのドロップが打て、奥から奥への返球も楽にできる"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "드리븐 클리어, 하이 클리어, 각종 드롭·스매시가 능숙하고 코스도 대체로 정확함. 백핸드 드롭 직선·대각선 모두 가능하고 후위에서 후위로 수월하게 보냄"
          }
        },
        "ms" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mahir clear menyerang, clear tinggi, serta semua dropshot dan smash, dengan penempatan yang kebanyakannya baik; dropshot backhand lurus dan silang, belakang ke belakang mudah"
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ลูกโด่งบุก ลูกโด่ง หยอดและตบทุกแบบได้คล่อง ตำแหน่งลูกแม่นเป็นส่วนใหญ่; หยอดแบ็คแฮนด์ได้ทั้งตรงและทแยง ตีจากท้ายคอร์ทไปท้ายคอร์ทได้สบาย"
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Thành thạo phông cầu tấn công, phông cầu cao sâu, mọi kiểu bỏ nhỏ và đập cầu, điểm rơi phần lớn chuẩn; bỏ nhỏ trái tay được cả thẳng lẫn chéo, đánh từ cuối sân về cuối sân dễ dàng"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "平高球、高遠球、各種吊殺熟練，落點基本到位；反手直線斜線吊都會，後場回後場輕鬆"
          }
        }
      }
    },
