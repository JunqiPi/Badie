        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Giai đoạn học kỹ thuật: lần lượt học giao cầu, phông cầu thuận và trái tay, bỏ nhỏ, đập cầu, đánh lưới, hất cầu và đỡ đập"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
