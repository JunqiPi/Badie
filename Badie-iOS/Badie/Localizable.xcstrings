          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "นับเฉพาะเกมที่ทั้งสองฝ่ายยืนยัน คำนวณใหม่ทุกวันที่ 1 ของเดือน คู่แข่งคนเดิมนับได้สูงสุด %lld เกมต่อเดือน"
          }
