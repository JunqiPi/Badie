    "在业余里很高，和专业选手比失误还多" : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Very high for an amateur, but still more errors than the pros"
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "शौकिया के लिए बहुत ऊँचा, पर प्रोफ़ेशनल से अब भी ज़्यादा गलतियाँ"
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sangat tinggi untuk amatir, tapi masih lebih banyak salah dibanding pemain pro"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "アマチュアとしては非常に高いが、プロと比べるとまだミスが多い"
